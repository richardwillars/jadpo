{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Jadpo",
  "scopeName": "source.jadpo",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#types" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": { "patterns": [{ "name": "comment.line.double-slash.jadpo", "match": "//.*$" }] },
    "strings": { "patterns": [{ "name": "string.quoted.double.jadpo", "begin": "\"", "end": "\"", "patterns": [{ "name": "constant.character.escape.jadpo", "match": "\\\\[\\\"\\\\nrt]" }] }] },
    "numbers": { "patterns": [{ "name": "constant.numeric.jadpo", "match": "\\b-?[0-9]+(?:\\.[0-9]+)?\\b" }] },
    "declarations": { "patterns": [{ "match": "\\b(application|principal|type|entity|value|input|output|enum|persist|config|failure|function|action|query|test|route|module|import)\\s+([A-Za-z_][A-Za-z0-9_]*|\"[^\"]*\")", "captures": { "1": { "name": "keyword.declaration.jadpo" }, "2": { "name": "entity.name.type.jadpo" } } }] },
    "keywords": { "patterns": [{ "name": "keyword.control.jadpo", "match": "\\b(if|else|match|success|return|reject|propagate|attempt|async|await|assert|var|mut|fails|kind|create|query|update|delete|where|include|into|missing|conflict|public|internal|authentication|principal|revocation|mode|immediate|bounded|maximum_delay|user|service|auth|path|input|output|run|optional|required|many|identity|persistence|store|role|authority|cache|projection|from|strategy|delivery|durable|freshness|authoritative|read_your_writes|bounded_staleness|eventual|consistency|atomic|durable_workflow|guard|reload|revision|ref|value|unique|index|inverse|via|references|as|on_delete|constraint|binding|secret|default|min|max|min_length|max_length|pattern|format)\\b" }] },
    "constants": { "patterns": [{ "name": "constant.language.jadpo", "match": "\\b(true|false|none)\\b" }] },
    "types": { "patterns": [{ "name": "support.type.primitive.jadpo", "match": "\\b(Bool|Int|Decimal|Text|Bytes|Uuid|Date|Time|DateTime|Duration|Unit|Object|List|Set|Map|Email|Url|IpAddress|Enum)\\b" }, { "name": "entity.name.type.jadpo", "match": "\\b[A-Z][A-Za-z0-9_]*\\b" }] },
    "operators": { "patterns": [{ "name": "keyword.operator.jadpo", "match": "==|!=|<=|>=|=>|->|[+\\-*\\/%<>=]|\\b(and|or|not)\\b" }] }
  }
}
