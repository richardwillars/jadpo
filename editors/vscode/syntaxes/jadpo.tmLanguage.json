{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Jadpo",
  "scopeName": "source.jadpo",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#types" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": { "patterns": [{ "name": "comment.line.double-slash.jadpo", "match": "//.*$" }] },
    "strings": { "patterns": [{ "name": "string.quoted.double.jadpo", "begin": "\"", "end": "\"", "patterns": [{ "name": "constant.character.escape.jadpo", "match": "\\\\[\\\"\\\\nrt]" }] }] },
    "numbers": { "patterns": [{ "name": "constant.numeric.jadpo", "match": "\\b-?[0-9]+(?:\\.[0-9]+)?\\b" }] },
    "declarations": { "patterns": [{ "match": "\\b(type|enum|entity|value|input|output|failure|function|action|test|route|module|import)\\s+([A-Za-z_][A-Za-z0-9_]*|\"[^\"]*\")", "captures": { "1": { "name": "keyword.declaration.jadpo" }, "2": { "name": "entity.name.type.jadpo" } } }] },
    "keywords": { "patterns": [{ "name": "keyword.control.jadpo", "match": "\\b(if|else|match|return|reject|assert|var|mut|fails|create|query|update|delete|where|include|into|missing|conflict|public|internal|auth|explicitly|run|optional|required|many|inverse|via|references|as|on_delete|constraint)\\b" }] },
    "constants": { "patterns": [{ "name": "constant.language.jadpo", "match": "\\b(true|false|none)\\b" }] },
    "types": { "patterns": [{ "name": "support.type.primitive.jadpo", "match": "\\b(Bool|Int|Decimal|Text|Uuid|DateTime|Unit|List)\\b" }, { "name": "entity.name.type.jadpo", "match": "\\b[A-Z][A-Za-z0-9_]*\\b" }] },
    "operators": { "patterns": [{ "name": "keyword.operator.jadpo", "match": "==|!=|<=|>=|=>|->|[+\\-*\\/%<>=]|\\b(and|or|not)\\b" }] }
  }
}
