{
  "Authentication foundation": {
    "prefix": "authentication-foundation",
    "body": [
      "application ${1:Application} {",
      "    authentication {",
      "        principal: ${2:Principal}",
      "        revocation {",
      "            mode: ${3:bounded}",
      "            maximum_delay: ${4:5m}",
      "        }",
      "    }",
      "}",
      "",
      "principal ${2:Principal} {",
      "    user {",
      "        subject: Text",
      "        user_id: ${5:User.id}",
      "    }",
      "    service {",
      "        subject: Text",
      "        service_id: ${6:Service.id}",
      "    }",
      "}"
    ],
    "description": "Project authentication default and closed user/service principal"
  },
  "Configuration": {
    "prefix": "config",
    "body": [
      "config ${1:ApplicationConfiguration} {",
      "    ${2:api_key}: ${3:ApiKey} {",
      "        binding: \"${4:API_KEY}\"",
      "        secret: ${5:true}",
      "    }",
      "}"
    ],
    "description": "Typed startup configuration with an explicit environment binding"
  },
  "Enum": {
    "prefix": "enum",
    "body": ["type ${1:State} = Enum {", "    ${2:ready}", "    ${3:failed}", "}"],
    "description": "Closed enum"
  },
  "Tagged enum": {
    "prefix": "tagged-enum",
    "body": [
      "type ${1:Outcome} = Enum {",
      "    ${2:pending}",
      "    ${3:complete} {",
      "        ${4:value}: ${5:Text}",
      "    }",
      "}"
    ],
    "description": "Closed enum with a data-carrying variant"
  },
  "Object type": {
    "prefix": "object",
    "body": ["type ${1:Customer} = Object {", "    ${2:id}: ${3:Uuid}", "}"],
    "description": "Closed object type"
  },
  "Persist object": {
    "prefix": "persist",
    "body": ["persist ${1:Customer} {", "    identity: ${2:id}", "}"],
    "description": "Opt an object type into persistence"
  },
  "Entity dossier": {
    "prefix": "entity-dossier",
    "body": [
      "entity ${1:Customer} {",
      "    ${2:id}: ${3:Uuid}",
      "    ${4:email}: ${5:Email}",
      "",
      "    identity: ${2:id}",
      "",
      "    persistence {",
      "        store: ${6:primary}",
      "        role: authority",
      "    }",
      "",
      "    query ${7:by_id}(id: ${1:Customer}.${2:id})",
      "        freshness: authoritative",
      "        -> ${1:Customer}?",
      "    {",
      "        return attempt query optional ${1:Customer} {",
      "            where: ${2:id} == id",
      "        }",
      "    }",
      "}"
    ],
    "description": "Identity-bearing entity with optional authority persistence and a named query"
  },
  "Fallible action": {
    "prefix": "action-fails",
    "body": ["action ${1:name}(${2:input}: ${3:Input})", "    fails ${4:DomainFailure}", "    -> ${5:Output}", "{", "    ${6}", "}"],
    "description": "Action with a declared failure surface"
  },
  "Exhaustive match": {
    "prefix": "match",
    "body": ["match ${1:value} {", "    ${2:State.ready} => {", "        ${3}", "    }", "    ${4:State.failed} => {", "        ${5}", "    }", "}"],
    "description": "Exhaustive match"
  },
  "Exhaustive outcome match": {
    "prefix": "match-outcome",
    "body": [
      "match ${1:operation}(${2}) {",
      "    success(${3:value}) => ${3:value}",
      "    failure ${4:FailureName} => ${5:propagate}",
      "}"
    ],
    "description": "Acknowledge every success and failure outcome"
  },
  "Test": {
    "prefix": "test",
    "body": ["test \"${1:behaviour}\" {", "    ${2:assert true}", "}"],
    "description": "Authored Jadpo test"
  },
  "Optional match": {
    "prefix": "match-optional",
    "body": [
      "match ${1:value} {",
      "    none => {",
      "        ${2}",
      "    }",
      "    some(${3:present}) => {",
      "        ${4}",
      "    }",
      "}"
    ],
    "description": "Exhaustively match and narrow a nullable value"
  },
  "Failure declaration": {
    "prefix": "failure",
    "body": [
      "failure ${1:DomainFailure} {",
      "    kind: ${2:Rejected}",
      "    code: \"${3:domain_failure}\"",
      "    message: \"${4:Request failed.}\"",
      "}"
    ],
    "description": "Reusable application failure with an explicit standard kind"
  },
  "Inline route action": {
    "prefix": "route-action",
    "body": [
      "route ${1:GET} ${2:/resource/{resource_id}} {",
      "    auth: none",
      "    path: {",
      "        resource_id: ${3:Resource.id}",
      "    }",
      "    output: ${4:Resource}",
      "    action: ${5}{",
      "        ${6}",
      "    }",
      "}"
    ],
    "description": "Route-local action with typed path binding"
  }
}
