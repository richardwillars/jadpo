{
  "$schema": "../tooling/node_modules/wrangler/config-schema.json",
  "name": "jadpo-wasm-exp1-local-storage-smoke",
  "main": "local-worker.ts",
  "compatibility_date": "2026-09-30",
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "STORAGE_SMOKE", "class_name": "StorageSmoke" }]
  },
  "migrations": [{ "tag": "local-v1", "new_sqlite_classes": ["StorageSmoke"] }]
}
