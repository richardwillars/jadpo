type ItemTitle = Text {
    min_length: 3
    max_length: 12
}

type ProbeInput = Object {
    id: Item.id
    title: ItemTitle
    note: Text? optional
}

type ItemPatch = Object {
    title: Item.title optional
    note: Item.note optional
}

enum ItemRole {
    owner
}

failure ItemMissing {
    kind: NotFound
    code: "item_missing"
}

failure ItemConflict {
    kind: Conflict
    code: "item_conflict"
}

failure EmptyPatch {
    kind: InvalidValue
    code: "empty_patch"
}

entity User {
    id: Uuid
    identity: id
}

entity Item {
    id: Uuid
    owner_id: User.id {
        role: ItemRole.owner
        immutable: true
    }
    title: ItemTitle
    note: Text?
    identity: id

    persistence {
        store: primary
        role: authority
        unique: title
    }

    policy {
        ItemRole.owner: [read, update]
    }

    query read(id: Item.id)
        freshness: authoritative
        fails ItemMissing
        -> Item
    {
        return attempt query required Item {
            where: id == id
            missing: ItemMissing
        }
    }

    query read_title(id: Item.id)
        freshness: authoritative
        fails ItemMissing
        -> ItemTitle
    {
        var item = attempt Item.read(id)
        return item.title
    }

    action change(id: Item.id, changes: ItemPatch)
        fails EmptyPatch, ItemMissing, ItemConflict
        -> Item
    {
        return attempt update required Item {
            where: id == id
            patch: changes
            empty: EmptyPatch
            missing: ItemMissing
            conflict: ItemConflict
        }
    }

    action rename(id: Item.id, title: Item.title)
        fails ItemMissing, ItemConflict
        -> Item
    {
        return attempt update required Item {
            where: id == id
            set: { title: title }
            missing: ItemMissing
            conflict: ItemConflict
        }
    }
}

action probe(input: ProbeInput) -> ItemTitle {
    return match Item.read_title(input.id) {
        success(title) => title
        failure ItemMissing => input.title
    }
}

action update_pair(
    first_id: Item.id,
    first_title: Item.title,
    second_id: Item.id,
    second_title: Item.title
)
    consistency: atomic
    fails ItemMissing, ItemConflict
    -> Item
{
    var first = attempt Item.rename(first_id, first_title)
    return attempt Item.rename(second_id, second_title)
}
