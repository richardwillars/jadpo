application PolicyExperiment {
    authentication {
        principal: Principal
        revocation { mode: immediate }
    }
}
config Secrets {
    signing_key: Text { binding: "AUTH_SIGNING_KEY" secret: true }
    previous_key: Text { binding: "AUTH_PREVIOUS_SIGNING_KEY" secret: true }
}
principal Principal {
    user { subject: Text user_id: Uuid }
    service { subject: Text service_id: Uuid }
}
entity User {
    id: Uuid
    identity: id
    persistence { store: primary role: authority }
    authentication_subject: Text unique
    enabled: Bool
}
failure UserDisabled { kind: Rejected code: "user_disabled" }
authentication api_bearer {
    transport { bearer: authorization_header }
    validators {
        opaque_user {
            mode: opaque
            principal: user
            secret: config.signing_key
            previous_secret: config.previous_key
            audience: "policy-experiment"
        }
    }
    resolution user {
        authority: User.authentication_subject
        active: enabled == true
        mappings {
            authentication_subject -> Principal.user.subject
            id -> Principal.user.user_id
        }
        inactive: UserDisabled
    }
}
type Title = Text { min_length: 3 max_length: 32 }
enum NoteRole { owner editor }
failure NoteMissing { kind: NotFound code: "note_missing" }
failure NoteConflict { kind: Conflict code: "note_conflict" }
failure ChangeRejected { kind: Rejected code: "change_rejected" }
input Lookup { id: Note.id }
input Rename { id: Note.id title: Note.title }
input SecretChange { id: Note.id private_note: Note.private_note }
input PairChange { first: Note.id second: Note.id title: Note.title second_title: Note.title }
output Summary { id: Note.id title: Note.title }
output PrivateSummary { id: Note.id private_note: Note.private_note }
entity Note {
    id: Uuid
    identity: id
    persistence { store: primary role: authority }
    owner_id: User.id { role: NoteRole.owner immutable: true }
    editor_id: User.id { role: NoteRole.editor immutable: true }
    title: Title unique
    private_note: Text? {
        policy { NoteRole.owner: [read, update] }
    }
    policy {
        NoteRole.owner: [read, update]
        NoteRole.editor: [read, update]
        operations { private_details { NoteRole.owner: [read] } }
    }
    query summary(input: Lookup) freshness: authoritative fails NoteMissing -> Summary {
        var note = attempt query required Note { where: id == input.id missing: NoteMissing }
        return Summary { id: note.id title: note.title }
    }
    query private_details(input: Lookup) freshness: authoritative fails NoteMissing -> PrivateSummary {
        var note = attempt query required Note { where: id == input.id missing: NoteMissing }
        return PrivateSummary { id: note.id private_note: note.private_note }
    }
    action rename(input: Rename) fails NoteMissing, NoteConflict -> Summary {
        var note = attempt update required Note { where: id == input.id set: { title: input.title } missing: NoteMissing conflict: NoteConflict }
        return Summary { id: note.id title: note.title }
    }
    action change_secret(input: SecretChange) fails NoteMissing, NoteConflict -> Summary {
        var note = attempt update required Note { where: id == input.id set: { private_note: input.private_note } missing: NoteMissing conflict: NoteConflict }
        return Summary { id: note.id title: note.title }
    }
}
action rename_pair(input: PairChange) consistency: atomic fails NoteMissing, NoteConflict -> Summary {
    var first = attempt Note.rename(Rename { id: input.first title: input.title })
    return attempt Note.rename(Rename { id: input.second title: input.second_title })
}
action rename_then_reject(input: Rename) consistency: atomic fails NoteMissing, NoteConflict, ChangeRejected -> Summary {
    var changed = attempt Note.rename(input)
    reject ChangeRejected
}
route POST /notes/read { input: Lookup output: Summary run: Note.summary(input) }
route POST /notes/private { input: Lookup output: PrivateSummary run: Note.private_details(input) }
route POST /notes/rename { input: Rename output: Summary run: Note.rename(input) }
route POST /notes/secret { input: SecretChange output: Summary run: Note.change_secret(input) }
route POST /notes/pair { input: PairChange output: Summary run: rename_pair(input) }
route POST /notes/reject { input: Rename output: Summary run: rename_then_reject(input) }
