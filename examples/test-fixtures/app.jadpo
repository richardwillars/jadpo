type RequestTimeout = Duration {}

type ApiKey = Text {
    min_length: 8
}

config ApplicationConfiguration {
    request_timeout: RequestTimeout {
        binding: "REQUEST_TIMEOUT"
    }

    api_key: ApiKey {
        binding: "API_KEY"
        secret: true
    }
}

fixture controlled_runtime {
    clock: fixed Instant("2026-01-15T12:00:00Z")

    config {
        request_timeout: RequestTimeout("PT3S")
        api_key: secret("test-only-api-key")
    }
}

value FixtureReading {
    observed_at: Instant
    request_timeout: RequestTimeout
}

action read_fixture_runtime() -> FixtureReading {
    return FixtureReading {
        observed_at: clock.now
        request_timeout: config.request_timeout
    }
}

test "fixture clock advances only the next operation" using controlled_runtime {
    var first = call read_fixture_runtime()
    advance clock by Duration("PT5M")
    var second = call read_fixture_runtime()

    assert first.observed_at == Instant("2026-01-15T12:00:00Z")
    assert second.observed_at == Instant("2026-01-15T12:05:00Z")
    assert second.request_timeout == RequestTimeout("PT3S")
}

test "each test receives a fresh fixture" using controlled_runtime {
    var reading = call read_fixture_runtime()

    assert reading.observed_at == Instant("2026-01-15T12:00:00Z")
    assert reading.request_timeout == RequestTimeout("PT3S")
}
