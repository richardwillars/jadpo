enum CompanyRole {
    owner
    editor
    viewer
}

enum ApplicationRole {
    operator
    administrator
}

failure UserNotFound {
    kind: NotFound
    code: "user_not_found"
}

output UserSummary {
    id: User.id
    display_name: User.display_name
}

output UserAdministrativeDetails {
    id: User.id
    display_name: User.display_name
    private_email: User.private_email
}

entity User {
    id: Uuid identity
    display_name: Text
    private_email: Text {
        policy {
            ApplicationRole.administrator: [read]
        }
    }

    policy {
        Access.authenticated: [read]
        ApplicationRole.administrator: [read]

        operations {
            administrative_details {
                ApplicationRole.administrator: [read]
            }
        }
    }

    query summary(id: User.id)
        freshness: authoritative
        fails UserNotFound
        -> UserSummary
    {
        var user = attempt query required User {
            where: id == id
            missing: UserNotFound
        }
        return UserSummary {
            id: user.id
            display_name: user.display_name
        }
    }

    query administrative_details(id: User.id)
        freshness: authoritative
        fails UserNotFound
        -> UserAdministrativeDetails
    {
        var user = attempt query required User {
            where: id == id
            missing: UserNotFound
        }
        return UserAdministrativeDetails {
            id: user.id
            display_name: user.display_name
            private_email: user.private_email
        }
    }
}

entity Service {
    id: Uuid identity
}

entity Company {
    id: Uuid identity
    owner_id: User.id {
        role: CompanyRole.owner
        immutable: true
    }
    name: Text

    policy {
        CompanyRole.owner: [read, update, delete]
        CompanyRole.editor: [read]
        CompanyRole.viewer: [read]
    }
}

entity CompanyMembership {
    id: Uuid identity
    company_id: Company.id
    user_id: User.id
    role: CompanyRole

    membership {
        scope: company_id
        member: user_id
        role: role
    }

    policy {
        CompanyRole.owner: [create, read, update, delete]
    }
}

entity ApplicationMembership {
    id: Uuid identity
    user_id: User.id
    role: ApplicationRole

    membership {
        scope: application
        member: user_id
        role: role
    }
}

entity ApplicationServiceMembership {
    id: Uuid identity
    service_id: Service.id
    role: ApplicationRole

    membership {
        scope: application
        member: service_id
        role: role
    }
}

entity Article {
    id: Uuid identity
    company_id: Company.id {
        immutable: true
    }
    title: Text
    billing_reference: Text? {
        policy {
            CompanyRole.owner: [read, update]
        }
    }

    policy {
        CompanyRole.owner: [create, read, update, delete]
        CompanyRole.editor: [read, update]
        CompanyRole.viewer: [read]
    }
}

output Health {
    ok: Bool
}

action administrative_health() -> Health {
    policy {
        ApplicationRole.operator: [invoke]
    }
    return Health { ok: true }
}

action public_health() -> Health {
    policy {
        Access.public: [invoke]
    }
    return Health { ok: true }
}

route GET /public-health {
    auth: none
    output: Health
    run: public_health()
}
