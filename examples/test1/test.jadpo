// Canonical source for the first compiler slice.

type Email = Text {
    format email
    max_length 254
}

type InviteCode = Text {
    min_length 6
    max_length 32
    pattern "[a-z0-9_]+"
}

entity Customer {
    id: Uuid
    email: Email
}

input RegisterCustomer {
    email: Customer.email
    invite_code: InviteCode
}

output RegistrationAccepted {
    email: Customer.email
}
// todo: Lets also explore creating an output for a route where it's a type excluding certain properties

failure InviteCodeRejected: Rejected {
    code "invite_code_rejected"
    message "That invite code cannot be used."

    internal {
        invite_code: InviteCode
    }
}

action register_customer(
    input: RegisterCustomer
) -> RegistrationAccepted
    fails InviteCodeRejected
{
    var reserved_invite_code = InviteCode("reserved")

    if (input.invite_code == reserved_invite_code) {
        reject InviteCodeRejected {
            internal {
                invite_code: input.invite_code
            }
        }
    }

    return RegistrationAccepted {
        email: input.email
    }
}

route POST /registrations {
    auth: public explicitly
    input: RegisterCustomer
    output: RegistrationAccepted
    run: register_customer(input)
}