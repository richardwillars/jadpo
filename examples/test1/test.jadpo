type Email = Text {
    format email
    max_length 254
}

type InviteCode = Text {
    min_length 6
    max_length 32
    pattern "[a-z0-9_]+"
}

entity Customer {
    id: Uuid identity
    email: Email
}

input RegisterCustomer {
    email: Customer.email
    invite_code: InviteCode
}

output RegistrationAccepted {
    email: Customer.email
}

failure InviteCodeRejected {
    kind Rejected
    code "invite_code_rejected"
    message "That invite code cannot be used."

    internal {
        invite_code: InviteCode
    }
}

action register_customer(
    input: RegisterCustomer
) -> RegistrationAccepted fails InviteCodeRejected
{
    var reserved_invite_code = InviteCode("reserved")

    if (input.invite_code == reserved_invite_code) {
        reject InviteCodeRejected {
            invite_code: input.invite_code
        }
    }

    return RegistrationAccepted {
        email: input.email
    }
}

route POST /registrations {
    auth: none
    input: RegisterCustomer
    output: RegistrationAccepted
    run: register_customer(input)
}