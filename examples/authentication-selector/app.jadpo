application SelectorApplication {
    authentication {
        principal: Principal
        revocation {
            mode: bounded
            maximum_delay: 5m
        }
    }
}

principal Principal {
    user {
        subject: Text
        user_id: Uuid
    }
    service {
        subject: Text
        service_id: Uuid
    }
}

entity User {
    id: Uuid identity
    authentication_subject: Text unique
    enabled: Bool
}

entity Service {
    id: Uuid identity
    authentication_subject: Text unique
    enabled: Bool
}

failure PrincipalInactive {
    kind: Rejected
    code: "principal_inactive"
    message: "Principal is inactive."
}

authentication browser_session {
    transport { cookie: "selector_session" }
    validators {
        signed_user { mode: signed principal: user }
    }
    claims {
        subject -> Principal.user.subject
    }
    resolution user {
        authority: User.authentication_subject
        active: enabled == true
        mappings {
            authentication_subject -> Principal.user.subject
            id -> Principal.user.user_id
        }
        inactive: PrincipalInactive
    }
}

authentication api_bearer {
    transport { bearer: authorization_header }
    validators {
        opaque_user { mode: opaque principal: user }
        service_key { mode: api_key principal: service }
    }
    resolution user {
        authority: User.authentication_subject
        active: enabled == true
        mappings {
            authentication_subject -> Principal.user.subject
            id -> Principal.user.user_id
        }
        inactive: PrincipalInactive
    }
    resolution service {
        authority: Service.authentication_subject
        active: enabled == true
        mappings {
            authentication_subject -> Principal.service.subject
            id -> Principal.service.service_id
        }
        inactive: PrincipalInactive
    }
}

output PublicHealth {
    ready: Bool
}

route GET /health/live {
    auth: none
    output: PublicHealth
    action: {
        return PublicHealth { ready: true }
    }
}
