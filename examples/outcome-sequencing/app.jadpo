type LookupCode = Text {}
type LookupResult = Text {}

failure LookupMissing {
    kind: NotFound
    code: "lookup_missing"
    message: "Lookup value was not found."
}

failure LookupRefused {
    kind: Rejected
    code: "lookup_refused"
    message: "Lookup was refused."
}

failure LookupRejected {
    kind: Rejected
    code: "lookup_rejected"
    message: "Lookup failure was mapped."
}

function lookup(key: LookupCode)
    fails LookupMissing, LookupRefused
    -> LookupResult
{
    if key == LookupCode("missing") {
        reject LookupMissing
    }
    if key == LookupCode("refused") {
        reject LookupRefused
    }
    return LookupResult("found")
}

function recover_lookup(key: LookupCode) -> LookupResult {
    return match lookup(key) {
        success(value) => value
        failure LookupMissing => LookupResult("recovered")
        failure LookupRefused => LookupResult("recovered")
    }
}

function map_lookup(key: LookupCode)
    fails LookupRejected
    -> LookupResult
{
    return match lookup(key) {
        success(value) => value
        failure LookupMissing => reject LookupRejected
        failure LookupRefused => reject LookupRejected
    }
}

function propagate_lookup(key: LookupCode)
    fails LookupMissing, LookupRefused
    -> LookupResult
{
    return match lookup(key) {
        success(value) => value
        failure LookupMissing => propagate
        failure LookupRefused => propagate
    }
}

action recover_demo() -> LookupResult {
    return recover_lookup(LookupCode("missing"))
}

action success_demo() -> LookupResult {
    return recover_lookup(LookupCode("present"))
}

action map_demo()
    fails LookupRejected
    -> LookupResult
{
    return attempt map_lookup(LookupCode("missing"))
}

action propagate_demo()
    fails LookupMissing, LookupRefused
    -> LookupResult
{
    return attempt propagate_lookup(LookupCode("missing"))
}

route GET /outcomes/recover {
    auth: none
    output: LookupResult
    run: recover_demo()
}

route GET /outcomes/success {
    auth: none
    output: LookupResult
    run: success_demo()
}

route GET /outcomes/map {
    auth: none
    output: LookupResult
    run: map_demo()
}

route GET /outcomes/propagate {
    auth: none
    output: LookupResult
    run: propagate_demo()
}
