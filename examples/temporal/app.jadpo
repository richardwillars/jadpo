locales {
    default: "en-GB"
    supported: ["en-GB", "en-US", "fr-FR"]
    unsupported: fallback_to_default
}

test "instant offsets canonicalise" {
    var first = Instant("2026-01-15T12:00:00Z")
    var second = Instant("2026-01-15T13:00:00+01:00")
    var earlier = temporal.add_elapsed(first, Duration("-PT1H"))
    assert first == second
    assert temporal.between(first, earlier) == Duration("-PT1H")
}

test "London overlap policies are explicit" {
    var date = CalendarDate("2026-10-25")
    var earlier = temporal.resolve(
        date: date,
        at: "01:30",
        zone: Zone.europe_london,
        overlap: LocalOverlap.earlier,
        gap: LocalGap.reject
    )
    var later = temporal.resolve(
        date: date,
        at: "01:30",
        zone: Zone.europe_london,
        overlap: LocalOverlap.later,
        gap: LocalGap.reject
    )
    assert temporal.between(earlier, later) == Duration("PT1H")
}

test "London autumn day has twenty five hours" {
    var bounds = temporal.day_bounds(
        CalendarDate("2026-10-25"),
        Zone.europe_london
    )
    assert temporal.between(bounds.start, bounds.end) == Duration("PT25H")
}

test "human formats require a resolved zone" {
    var value = temporal.in_zone(
        Instant("2026-09-27T13:30:00Z"),
        Zone.europe_london
    )
    var label = temporal.format(
        value,
        locale: Locale.en_gb,
        components: {
            day: numeric
            month: long
            year: numeric
            hour: two_digit
            minute: two_digit
            zone_name: short
        }
    )
    assert label == label
}
