type MailerApiKey = Text {
    min_length: 8
}

type RequestTimeout = Duration {}

output Health {
    ready: Bool
}

config ApplicationConfiguration {
    mailer_api_key: MailerApiKey {
        binding: "MAILER_API_KEY"
        secret: true
    }

    request_timeout: RequestTimeout {
        binding: "REQUEST_TIMEOUT"
        default: 5s
    }
}

route GET /health {
    auth: none
    output: Health
    action: {
        return Health {
            ready: true
        }
    }
}
