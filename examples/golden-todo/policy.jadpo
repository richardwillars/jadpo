// Human-owned policy for golden todo todo-v0.1.
// Ordinary implementation agents may read but may not authorise changes here.

policy TodoPolicy version "todo-policy-v0.1" {
    authentication {
        default required
        strategies session_cookie, oidc_bearer
        select exactly_one
        conflicting_credentials reject
        ambiguous_identity reject
        merge_privileges never
    }

    User {
        read when actor.user_id == User.id
        disable when actor.user_id == User.id

        fields {
            id: server_identity immutable
            authentication_subject: provisioning_only immutable
            email: provisioning_only
            status: lifecycle_only
            created_at: server_assigned immutable
            disabled_at: lifecycle_only
        }

        lifecycle {
            disable: soft
            children Todo: retain
            authentication_after_disable: reject
        }
    }

    Todo {
        create when actor.user_id == new.owner_id
        read when actor.user_id == Todo.owner_id and Todo.deleted_at == none
        update when actor.user_id == Todo.owner_id and Todo.deleted_at == none
        delete when actor.user_id == Todo.owner_id and Todo.deleted_at == none

        fields {
            id: server_identity immutable
            owner_id: server_assigned immutable
            title: client_create client_update
            status: server_default client_update
            due_at: client_create client_update nullable
            created_at: server_assigned immutable
            updated_at: server_assigned
            reminder_sent_at {
                write from job overdue_reminders
                clear when PatchTodo.due_at supplied
                client_write: never
            }
            deleted_at: lifecycle_only
        }

        lifecycle {
            delete: soft
            retain_for: config.soft_delete_retention
            purge_after_retention: hard
            restore: prohibited
        }
    }

    external_effect ReminderMail.send_overdue_reminder {
        permit from job overdue_reminders
        recipient: Todo.owner.email
        secret: config.mail_api_key only_to ReminderMail credential
        idempotency_key: Todo.id
    }

    public_route GET /health/live {
        exposes PublicHealth
        dependencies none
        secrets none
    }

    deployment_probe readiness database {
        access: deployment_plane
        exposes: safe_dependency_status
        secrets: none
    }
}
