// Golden todo todo-v0.1.
// This source is canonical design input for P10.5/P11. Unsupported constructs
// are enumerated in language-friction.md rather than replaced with host code.

application TodoApplication {
    authentication {
        principal: Principal
        revocation {
            mode: bounded
            maximum_delay: 5m
        }
    }
}

type TodoTitle = Text {
    min_length: 1
    max_length: 200
}

type PageSize = Int {
    min: 1
    max: 100
}

type UserStatus = Enum {
    active
    disabled
}

type ServiceStatus = Enum {
    active
    disabled
}

type CredentialStatus = Enum {
    active
    revoked
}

type TodoStatus = Enum {
    open
    completed
}

type AuthenticationStrength = Enum {
    primary
    multi_factor
}

type DatabaseUrl = Url {}
type SessionSigningKey = Text { min_length: 32 }
type MailApiKey = Text { min_length: 16 }
type CredentialVerifier = Text { min_length: 32 }

config TodoConfiguration {
    database_url: DatabaseUrl {
        binding: "DATABASE_URL"
        secret: true
    }
    session_signing_key: SessionSigningKey {
        binding: "SESSION_SIGNING_KEY"
        secret: true
    }
    oidc_issuer: Url {
        binding: "OIDC_ISSUER"
    }
    oidc_audience: Text {
        binding: "OIDC_AUDIENCE"
    }
    mail_api_key: MailApiKey {
        binding: "MAIL_API_KEY"
        secret: true
    }
    mail_sender: Email {
        binding: "MAIL_SENDER"
    }
    soft_delete_retention: Duration {
        binding: "SOFT_DELETE_RETENTION"
        default: 30d
    }
}

principal Principal {
    user {
        subject: Text
        user_id: User.id
        email: Email
        authentication_strength: AuthenticationStrength
    }
    service {
        subject: Text
        service_id: Service.id
        authentication_strength: AuthenticationStrength
    }
}

authentication browser_session {
    transport {
        cookie: "todo_session"
    }
    validators {
        signed_user {
            mode: signed
            principal: user
            secret: config.session_signing_key
            audience: "todo-browser"
            expires: 5m
        }
    }
    claims {
        subject -> Principal.user.subject
        authentication_strength -> Principal.user.authentication_strength
    }
    resolve: User.authentication_subject where status == UserStatus.active {
        id -> Principal.user.user_id
        email -> Principal.user.email
        inactive: UserDisabled
    }
}

authentication api_bearer {
    transport {
        bearer: authorization_header
    }
    validators {
        signed_user {
            mode: signed
            principal: user
            secret: config.session_signing_key
            audience: "todo-api"
            expires: 5m
        }
        jwt_user {
            mode: jwt
            principal: user
            issuer: config.oidc_issuer
            audience: config.oidc_audience
            algorithms: compiler_allowlist
        }
        service_api_key {
            mode: api_key
            principal: service
            authority: ServiceCredential.verifier
        }
    }
    user_resolution: User.authentication_subject where status == UserStatus.active {
        id -> Principal.user.user_id
        email -> Principal.user.email
        inactive: UserDisabled
    }
    service_resolution: ServiceCredential.verifier where status == CredentialStatus.active {
        service_id -> Principal.service.service_id
        inactive: ServiceDisabled
    }
}

type User = Object {
    id: Uuid
    authentication_subject: Text
    email: Email
    status: UserStatus default UserStatus.active
    created_at: Instant generated { on: create }
    disabled_at: Instant?
}

persist User {
    identity: id
    unique: authentication_subject
    unique: email
    inverse todos: many Todo via: Todo.owner_id
}

type Service = Object {
    id: Uuid
    owner_id: User.id
    name: Text
    status: ServiceStatus default ServiceStatus.active
    created_at: Instant generated { on: create }
    disabled_at: Instant?
}

persist Service {
    identity: id
    unique: name
    references owner_id: User.id as: owner on_delete: restrict
    inverse credentials: many ServiceCredential via: ServiceCredential.service_id
}

type ServiceCredential = Object {
    id: Uuid
    service_id: Service.id
    verifier: CredentialVerifier
    status: CredentialStatus default CredentialStatus.active
    expires_at: Instant
    created_at: Instant generated { on: create }
    revoked_at: Instant?
}

persist ServiceCredential {
    identity: id
    unique: verifier
    references service_id: Service.id as: service on_delete: cascade
}

type Todo = Object {
    id: Uuid
    owner_id: User.id
    title: TodoTitle
    status: TodoStatus default TodoStatus.open
    due_at: Instant?
    reminder_sent_at: Instant?
    created_at: Instant generated { on: create }
    updated_at: Instant generated { on: create_or_change }
    deleted_at: Instant?
}

persist Todo {
    identity: id
    references owner_id: User.id as: owner on_delete: restrict
}

// Compound non-unique index spelling remains deliberately unresolved:
// owner_active_order over owner_id, deleted_at, created_at, id
// reminder_scan over status, deleted_at, reminder_sent_at, due_at, id

type CreateTodo = Object {
    title: Todo.title
    due_at: Todo.due_at default none
}

type PatchTodo = Object {
    title: Todo.title optional
    status: Todo.status optional
    due_at: Todo.due_at optional
}

type ListTodos = Object {
    status: Todo.status optional
    due_before: Instant optional
    page_size: PageSize default 25
    after: TodoCursor optional
}

type DisableUser = Object {
    user_id: User.id
}

type TodoCursor = Object {
    created_at: Todo.created_at
    id: Todo.id
}

type TodoView = Object {
    id: Todo.id
    title: Todo.title
    status: Todo.status
    due_at: Todo.due_at
    created_at: Todo.created_at
    updated_at: Todo.updated_at
}

type TodoPage = Object {
    items: List<TodoView>
    next: TodoCursor?
}

type UserWithTodos = Object {
    user_id: User.id
    email: User.email
    todos: List<TodoView>
}

type PublicHealth = Object {
    status: HealthStatus
}

type HealthStatus = Enum {
    healthy
}

type ReminderMessage = Object {
    idempotency_key: Todo.id
    from: Email
    to: User.email
    todo_title: Todo.title
    due_at: Todo.due_at
}

type ReminderReceipt = Object {
    accepted_at: Instant
}

failure TodoNotFound {
    kind: NotFound
    code: "todo_not_found"
    message: "Todo not found."

    internal {
        todo_id: Todo.id
    }
}

failure UserNotFound {
    kind: NotFound
    code: "user_not_found"
    message: "User not found."

    internal {
        user_id: User.id
    }
}

failure UserDisabled {
    kind: NotPermitted
    code: "user_disabled"
    message: "This account is not available."
}

failure ServiceDisabled {
    kind: NotPermitted
    code: "service_disabled"
    message: "This service identity is not available."
}

failure EmptyPatch {
    kind: InvalidValue
    code: "empty_patch"
    message: "Supply at least one field to change."
}

failure DueDateInPast {
    kind: InvalidValue
    code: "due_date_in_past"
    message: "The due date must be in the future."
}

failure TodoMutationConflict {
    kind: Conflict
    code: "todo_mutation_conflict"
    message: "The todo could not be changed."
}

failure ReminderRecipientRejected {
    kind: Rejected
    code: "reminder_recipient_rejected"
    message: "The reminder recipient was rejected."
}

failure ReminderTemporarilyUnavailable {
    kind: Unavailable
    code: "reminder_temporarily_unavailable"
    message: "Reminder delivery is temporarily unavailable."
}

service ReminderMail {
    secret: config.mail_api_key
    base_url: "https://mail.example.invalid"
    timeout: 5s
    retry: exponential(max_attempts: 3, max_elapsed: 30s)
    egress: mail.example.invalid:443

    operation send_overdue_reminder
    POST /v1/messages
    idempotency_key: Todo.id
    input ReminderMessage
    output ReminderReceipt
    maps provider.invalid_recipient -> ReminderRecipientRejected
    maps provider.rate_limited -> ReminderTemporarilyUnavailable
    maps provider.timeout -> ReminderTemporarilyUnavailable
    maps provider.authentication -> fault Misconfigured
}

action create_todo(input: CreateTodo, principal: Principal.user)
    fails DueDateInPast, TodoMutationConflict
    -> TodoView
{
    require policy Todo.create with principal

    if input.due_at exists and input.due_at <= clock.now {
        reject DueDateInPast
    }

    var todo = attempt create Todo {
        owner_id: principal.user_id
        title: input.title
        status: TodoStatus.open
        due_at: input.due_at
        reminder_sent_at: none
        created_at: clock.now
        updated_at: clock.now
        deleted_at: none
    } conflict: TodoMutationConflict

    return project todo as TodoView
}

action list_todos(input: ListTodos, principal: Principal.user) -> TodoPage {
    require policy Todo.read with principal

    return attempt query page Todo {
        where: owner_id == principal.user_id
        and deleted_at == none
        and status matches optional input.status
        and due_at <= optional input.due_before
        order_by: created_at desc, id desc
        after: optional input.after
        limit: input.page_size
        project: TodoView
        cursor: TodoCursor(created_at, id)
    }
}

action get_todo(todo_id: Todo.id, principal: Principal.user)
    fails TodoNotFound
    -> TodoView
{
    require policy Todo.read with principal

    var todo = attempt query required Todo {
        where: id == todo_id
        and owner_id == principal.user_id
        and deleted_at == none
        missing: TodoNotFound {
            todo_id: todo_id
        }
    }

    return project todo as TodoView
}

action patch_todo(todo_id: Todo.id, input: PatchTodo, principal: Principal.user)
    fails TodoNotFound, EmptyPatch, DueDateInPast, TodoMutationConflict
    -> TodoView
{
    require policy Todo.update with principal

    if supplied_count(input) == 0 {
        reject EmptyPatch
    }

    if input.due_at supplied and input.due_at exists and input.due_at <= clock.now {
        reject DueDateInPast
    }

    var todo = attempt update required Todo {
        where: id == todo_id
        and owner_id == principal.user_id
        and deleted_at == none
        patch: input
        set: {
            updated_at: clock.now
            reminder_sent_at: none when input.due_at supplied
        }
        missing: TodoNotFound {
            todo_id: todo_id
        }
        conflict: TodoMutationConflict
    }

    return project todo as TodoView
}

action delete_todo(todo_id: Todo.id, principal: Principal.user)
    fails TodoNotFound, TodoMutationConflict
    -> None
{
    require policy Todo.delete with principal

    attempt update required Todo {
        where: id == todo_id
        and owner_id == principal.user_id
        and deleted_at == none
        set: {
            deleted_at: clock.now
            updated_at: clock.now
        }
        missing: TodoNotFound {
            todo_id: todo_id
        }
        conflict: TodoMutationConflict
    }

    return none
}

action read_user_with_todos(user_id: User.id, principal: Principal.user)
    fails UserNotFound
    -> UserWithTodos
{
    require principal.user_id == user_id
    require policy User.read with principal
    require policy Todo.read with principal through User.todos

    return attempt query required User {
        where: id == user_id and status == UserStatus.active
        include: todos into: UserWithTodos
        where: deleted_at == none
        order_by: created_at asc, id asc
        limit: 100
        missing: UserNotFound {
            user_id: user_id
        }
    }
}

action disable_user(input: DisableUser, principal: Principal.user)
    fails UserNotFound
    -> None
{
    require principal.user_id == input.user_id
    require policy User.disable with principal

    attempt update required User {
        where: id == input.user_id and status == UserStatus.active
        set: {
            status: UserStatus.disabled
            disabled_at: clock.now
        }
        missing: UserNotFound {
            user_id: input.user_id
        }
    }

    // User disablement retains todos. Authentication subsequently fails closed.
    return none
}

action send_due_reminders(at: Instant)
    fails ReminderRecipientRejected, ReminderTemporarilyUnavailable
    -> None
{
    var todos = attempt query many Todo {
        where: status == TodoStatus.open
        and deleted_at == none
        and reminder_sent_at == none
        and due_at < at
        order_by: due_at asc, id asc
        limit: 500
        include: owner required
    }

    for todo in todos max 500 {
        if todo.owner.status == UserStatus.active {
            var receipt = ReminderMail.send_overdue_reminder {
                idempotency_key: todo.id
                from: config.mail_sender
                to: todo.owner.email
                todo_title: todo.title
                due_at: todo.due_at
            }

            attempt update required Todo {
                where: id == todo.id and reminder_sent_at == none
                set: { reminder_sent_at: receipt.accepted_at }
            }
        }
    }

    return none
}

action purge_deleted_todos(at: Instant) -> None {
    delete many Todo {
        where: deleted_at exists
        and deleted_at <= at - config.soft_delete_retention
        order_by: deleted_at asc, id asc
        limit: 500
    }

    return none
}

route GET /health/live {
    auth: none
    run: liveness()
    output: PublicHealth
}

readiness database {
    access: deployment_plane
    timeout: 2s
    required: true
}

route POST /todos {
    input: CreateTodo
    run: create_todo(input, current_principal.user)
    output: TodoView
    success: created
}

route GET /todos {
    query: ListTodos
    run: list_todos(query, current_principal.user)
    output: TodoPage
}

route GET /todos/:todo_id {
    path: { todo_id: Todo.id }
    run: get_todo(path.todo_id, current_principal.user)
    output: TodoView
}

route PATCH /todos/:todo_id {
    path: { todo_id: Todo.id }
    input: PatchTodo
    run: patch_todo(path.todo_id, input, current_principal.user)
    output: TodoView
}

route DELETE /todos/:todo_id {
    path: { todo_id: Todo.id }
    run: delete_todo(path.todo_id, current_principal.user)
    output: none
    success: no_content
}

route GET /users/:user_id/todos {
    path: { user_id: User.id }
    run: read_user_with_todos(path.user_id, current_principal.user)
    output: UserWithTodos
}

route DELETE /users/:user_id {
    auth: fresh
    path: { user_id: User.id }
    run: disable_user(DisableUser { user_id: path.user_id }, current_principal.user)
    output: none
    success: no_content
}

job overdue_reminders every 15m {
    concurrency: singleton
    run: send_due_reminders(clock.now)
    retry: next_schedule
}

job purge_deleted_todos every 1h {
    concurrency: singleton
    run: purge_deleted_todos(clock.now)
    retry: next_schedule
}
