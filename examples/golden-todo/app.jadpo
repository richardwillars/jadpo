// Golden todo todo-v0.1.
// This source is canonical design input for P10.5/P11. Unsupported constructs
// are enumerated in language-friction.md rather than replaced with host code.

application TodoApplication {
    authentication: required
    clock: system_utc
}

type TodoTitle = Text {
    min_length: 1
    max_length: 200
}

type PageSize = Int {
    min: 1
    max: 100
}

type UserStatus = Enum {
    active
    disabled
}

type TodoStatus = Enum {
    open
    completed
}

type AuthenticationStrength = Enum {
    primary
    multi_factor
}

config TodoConfiguration {
    database_url: DatabaseUrl secret required restart
    session_signing_key: Secret required restart
    oidc_issuer: Url required restart
    oidc_audience: Text required restart
    mail_api_key: Secret required reloadable
    mail_sender: Email required restart
    soft_delete_retention: Duration default 30d restart
}

authentication session_cookie {
    strategy: signed_session
    secret: config.session_signing_key
    cookie: "todo_session"
    claims {
        subject -> Actor.subject
        authentication_strength -> Actor.authentication_strength
    }
    resolve: User.authentication_subject where status == UserStatus.active {
        id -> Actor.user_id
        email -> Actor.email
        inactive: UserDisabled
    }
}

authentication oidc_bearer {
    strategy: oidc
    issuer: config.oidc_issuer
    audience: config.oidc_audience
    claims {
        sub -> Actor.subject
        acr -> Actor.authentication_strength using oidc_acr
    }
    resolve: User.authentication_subject where status == UserStatus.active {
        id -> Actor.user_id
        email -> Actor.email
        inactive: UserDisabled
    }
}

actor Actor {
    subject: Text
    user_id: User.id
    email: Email
    authentication_strength: AuthenticationStrength
}

type User = Object {
    id: Uuid
    authentication_subject: Text
    email: Email
    status: UserStatus default UserStatus.active
    created_at: DateTime default now
    disabled_at: DateTime?
}

persist User {
    identity: id
    unique: authentication_subject
    unique: email
    inverse todos: many Todo via: Todo.owner_id
}

type Todo = Object {
    id: Uuid
    owner_id: User.id
    title: TodoTitle
    status: TodoStatus default TodoStatus.open
    due_at: DateTime?
    reminder_sent_at: DateTime?
    created_at: DateTime default now
    updated_at: DateTime default now
    deleted_at: DateTime?
}

persist Todo {
    identity: id
    references owner_id: User.id as: owner on_delete: restrict
}

// Compound non-unique index spelling remains deliberately unresolved:
// owner_active_order over owner_id, deleted_at, created_at, id
// reminder_scan over status, deleted_at, reminder_sent_at, due_at, id

type CreateTodo = Object {
    title: Todo.title
    due_at: Todo.due_at default none
}

type PatchTodo = Object {
    title: Todo.title optional
    status: Todo.status optional
    due_at: Todo.due_at optional
}

type ListTodos = Object {
    status: Todo.status optional
    due_before: DateTime optional
    page_size: PageSize default 25
    after: TodoCursor optional
}

type DisableUser = Object {
    user_id: User.id
}

type TodoCursor = Object {
    created_at: Todo.created_at
    id: Todo.id
}

type TodoView = Object {
    id: Todo.id
    title: Todo.title
    status: Todo.status
    due_at: Todo.due_at
    created_at: Todo.created_at
    updated_at: Todo.updated_at
}

type TodoPage = Object {
    items: List<TodoView>
    next: TodoCursor?
}

type UserWithTodos = Object {
    user_id: User.id
    email: User.email
    todos: List<TodoView>
}

type PublicHealth = Object {
    status: HealthStatus
}

type HealthStatus = Enum {
    healthy
}

type ReminderMessage = Object {
    idempotency_key: Todo.id
    from: Email
    to: User.email
    todo_title: Todo.title
    due_at: Todo.due_at
}

type ReminderReceipt = Object {
    accepted_at: DateTime
}

failure TodoNotFound {
    kind NotFound
    code "todo_not_found"
    message "Todo not found."

    internal {
        todo_id: Todo.id
    }
}

failure UserNotFound {
    kind NotFound
    code "user_not_found"
    message "User not found."

    internal {
        user_id: User.id
    }
}

failure UserDisabled {
    kind NotPermitted
    code "user_disabled"
    message "This account is not available."
}

failure EmptyPatch {
    kind InvalidValue
    code "empty_patch"
    message "Supply at least one field to change."
}

failure DueDateInPast {
    kind InvalidValue
    code "due_date_in_past"
    message "The due date must be in the future."
}

failure TodoMutationConflict {
    kind Conflict
    code "todo_mutation_conflict"
    message "The todo could not be changed."
}

failure ReminderRecipientRejected {
    kind Rejected
    code "reminder_recipient_rejected"
    message "The reminder recipient was rejected."
}

failure ReminderTemporarilyUnavailable {
    kind Unavailable
    code "reminder_temporarily_unavailable"
    message "Reminder delivery is temporarily unavailable."
}

service ReminderMail {
    secret: config.mail_api_key
    base_url: "https://mail.example.invalid"
    timeout: 5s
    retry: exponential(max_attempts: 3, max_elapsed: 30s)
    egress: mail.example.invalid:443

    operation send_overdue_reminder
    POST /v1/messages
    idempotency_key: Todo.id
    input ReminderMessage
    output ReminderReceipt
    maps provider.invalid_recipient -> ReminderRecipientRejected
    maps provider.rate_limited -> ReminderTemporarilyUnavailable
    maps provider.timeout -> ReminderTemporarilyUnavailable
    maps provider.authentication -> fault Misconfigured
}

action create_todo(input: CreateTodo, actor: Actor)
    fails DueDateInPast, TodoMutationConflict
    -> TodoView
{
    require policy Todo.create with actor

    if input.due_at exists and input.due_at <= clock.now {
        reject DueDateInPast
    }

    var todo = attempt create Todo {
        owner_id: actor.user_id
        title: input.title
        status: TodoStatus.open
        due_at: input.due_at
        reminder_sent_at: none
        created_at: clock.now
        updated_at: clock.now
        deleted_at: none
    } conflict: TodoMutationConflict

    return project todo as TodoView
}

action list_todos(input: ListTodos, actor: Actor) -> TodoPage {
    require policy Todo.read with actor

    return attempt query page Todo {
        where: owner_id == actor.user_id
        and deleted_at == none
        and status matches optional input.status
        and due_at <= optional input.due_before
        order_by: created_at desc, id desc
        after: optional input.after
        limit: input.page_size
        project: TodoView
        cursor: TodoCursor(created_at, id)
    }
}

action get_todo(todo_id: Todo.id, actor: Actor)
    fails TodoNotFound
    -> TodoView
{
    require policy Todo.read with actor

    var todo = attempt query required Todo {
        where: id == todo_id
        and owner_id == actor.user_id
        and deleted_at == none
        missing: TodoNotFound {
            todo_id: todo_id
        }
    }

    return project todo as TodoView
}

action patch_todo(todo_id: Todo.id, input: PatchTodo, actor: Actor)
    fails TodoNotFound, EmptyPatch, DueDateInPast, TodoMutationConflict
    -> TodoView
{
    require policy Todo.update with actor

    if supplied_count(input) == 0 {
        reject EmptyPatch
    }

    if input.due_at supplied and input.due_at exists and input.due_at <= clock.now {
        reject DueDateInPast
    }

    var todo = attempt update required Todo {
        where: id == todo_id
        and owner_id == actor.user_id
        and deleted_at == none
        patch: input
        set: {
            updated_at: clock.now
            reminder_sent_at: none when input.due_at supplied
        }
        missing: TodoNotFound {
            todo_id: todo_id
        }
        conflict: TodoMutationConflict
    }

    return project todo as TodoView
}

action delete_todo(todo_id: Todo.id, actor: Actor)
    fails TodoNotFound, TodoMutationConflict
    -> None
{
    require policy Todo.delete with actor

    attempt update required Todo {
        where: id == todo_id
        and owner_id == actor.user_id
        and deleted_at == none
        set: {
            deleted_at: clock.now
            updated_at: clock.now
        }
        missing: TodoNotFound {
            todo_id: todo_id
        }
        conflict: TodoMutationConflict
    }

    return none
}

action read_user_with_todos(user_id: User.id, actor: Actor)
    fails UserNotFound
    -> UserWithTodos
{
    require actor.user_id == user_id
    require policy User.read with actor
    require policy Todo.read with actor through User.todos

    return attempt query required User {
        where: id == user_id and status == UserStatus.active
        include: todos into: UserWithTodos
        where: deleted_at == none
        order_by: created_at asc, id asc
        limit: 100
        missing: UserNotFound {
            user_id: user_id
        }
    }
}

action disable_user(input: DisableUser, actor: Actor)
    fails UserNotFound
    -> None
{
    require actor.user_id == input.user_id
    require policy User.disable with actor

    attempt update required User {
        where: id == input.user_id and status == UserStatus.active
        set: {
            status: UserStatus.disabled
            disabled_at: clock.now
        }
        missing: UserNotFound {
            user_id: input.user_id
        }
    }

    // User disablement retains todos. Authentication subsequently fails closed.
    return none
}

action send_due_reminders(at: DateTime)
    fails ReminderRecipientRejected, ReminderTemporarilyUnavailable
    -> None
{
    var todos = attempt query many Todo {
        where: status == TodoStatus.open
        and deleted_at == none
        and reminder_sent_at == none
        and due_at < at
        order_by: due_at asc, id asc
        limit: 500
        include: owner required
    }

    for todo in todos max 500 {
        if todo.owner.status == UserStatus.active {
            var receipt = ReminderMail.send_overdue_reminder {
                idempotency_key: todo.id
                from: config.mail_sender
                to: todo.owner.email
                todo_title: todo.title
                due_at: todo.due_at
            }

            attempt update required Todo {
                where: id == todo.id and reminder_sent_at == none
                set: { reminder_sent_at: receipt.accepted_at }
            }
        }
    }

    return none
}

action purge_deleted_todos(at: DateTime) -> None {
    delete many Todo {
        where: deleted_at exists
        and deleted_at <= at - config.soft_delete_retention
        order_by: deleted_at asc, id asc
        limit: 500
    }

    return none
}

route GET /health/live {
    auth: none
    run: liveness()
    output: PublicHealth
}

readiness database {
    access: deployment_plane
    timeout: 2s
    required: true
}

route POST /todos {
    input: CreateTodo
    run: create_todo(input, current_actor)
    output: TodoView
    success: created
}

route GET /todos {
    query: ListTodos
    run: list_todos(query, current_actor)
    output: TodoPage
}

route GET /todos/:todo_id {
    path: { todo_id: Todo.id }
    run: get_todo(path.todo_id, current_actor)
    output: TodoView
}

route PATCH /todos/:todo_id {
    path: { todo_id: Todo.id }
    input: PatchTodo
    run: patch_todo(path.todo_id, input, current_actor)
    output: TodoView
}

route DELETE /todos/:todo_id {
    path: { todo_id: Todo.id }
    run: delete_todo(path.todo_id, current_actor)
    output: none
    success: no_content
}

route GET /users/:user_id/todos {
    path: { user_id: User.id }
    run: read_user_with_todos(path.user_id, current_actor)
    output: UserWithTodos
}

route DELETE /users/:user_id {
    path: { user_id: User.id }
    run: disable_user(DisableUser { user_id: path.user_id }, current_actor)
    output: none
    success: no_content
}

job overdue_reminders every 15m {
    concurrency: singleton
    run: send_due_reminders(clock.now)
    retry: next_schedule
}

job purge_deleted_todos every 1h {
    concurrency: singleton
    run: purge_deleted_todos(clock.now)
    retry: next_schedule
}
