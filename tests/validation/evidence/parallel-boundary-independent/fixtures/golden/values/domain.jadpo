type TodoTitle = Text {
    min_length: 1
    max_length: 200
}

type CredentialVerifier = Text {
    min_length: 32
}

type DatabaseUrl = Url {}

type SessionSigningKey = Text {
    min_length: 32
}

type MailApiKey = Text {
    min_length: 16
}

enum UserStatus {
    active
    disabled
}

enum ServiceStatus {
    active
    disabled
}

enum CredentialStatus {
    active
    revoked
}

enum TodoStatus {
    open
    completed
}

enum TodoRole {
    owner
}

enum UserRole {
    self
}
