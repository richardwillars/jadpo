route POST /todos {
    input: CreateTodo
    output: TodoView
    success: created
    run: Todo.create_todo(input, current_principal.user)
}

route GET /todos {
    query: ListTodos
    output: TodoPage
    run: Todo.list_todos(query, current_principal.user)
}

route PATCH /todos/{todo_id} {
    path: {
        todo_id: Todo.id
    }
    input: PatchTodo
    output: TodoView
    run: Todo.patch_todo(path.todo_id, input, current_principal.user)
}

route DELETE /todos/{todo_id} {
    path: {
        todo_id: Todo.id
    }
    success: no_content
    run: Todo.delete_todo(path.todo_id, current_principal.user)
}

route GET /users/{user_id}/todos {
    path: {
        user_id: User.id
    }
    output: UserWithTodos
    run: User.read_with_todos(path.user_id, current_principal.user)
}

route DELETE /users/{user_id} {
    auth: fresh
    path: {
        user_id: User.id
    }
    success: no_content
    run: User.disable_user(path.user_id, current_principal.user)
}
