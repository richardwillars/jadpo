failure TodoNotFound {
    kind: NotFound
    code: "todo_not_found"
    message: "Todo not found."

    internal {
        todo_id: Todo.id
    }
}

failure DueDateInPast {
    kind: InvalidValue
    code: "due_date_in_past"
    message: "The due date must be in the future."
}

failure EmptyPatch {
    kind: InvalidValue
    code: "empty_patch"
    message: "Supply at least one field to change."
}

failure TodoMutationConflict {
    kind: Conflict
    code: "todo_mutation_conflict"
    message: "The todo could not be changed."
}

entity Todo {
    id: Uuid { generated: identity }
    owner_id: User.id {
        role: TodoRole.owner
        immutable: true
    }
    title: TodoTitle
    status: TodoStatus
    due_at: Instant?
    reminder_sent_at: Instant?
    created_at: Instant generated { on: create }
    updated_at: Instant generated { on: create_or_change }
    deleted_at: Instant?

    identity: id

    persistence {
        store: primary
        role: authority
        references owner_id: User.id as: owner on_delete: restrict
    }

    lifecycle {
        initial: {
            deleted_at: none
        }
        visible when deleted_at == none
        transition delete {
            from: deleted_at == none
            set: { deleted_at: clock.now }
        }
        purge after config.soft_delete_retention from deleted_at
    }

    policy {
        TodoRole.owner: [create, read, update, delete]
    }

    query by_id(id: Todo.id)
    freshness: authoritative
        fails TodoNotFound
        -> TodoView
    {
        var todo = attempt query required Todo {
            where: id == id
            missing: TodoNotFound {
                todo_id: id
            }
        }

        match todo.deleted_at {
            some(deleted_at) => {
                reject TodoNotFound {
                    todo_id: id
                }
            }
            none => {}
        }

        return TodoView {
            id: todo.id
            title: todo.title
            status: todo.status
            due_at: todo.due_at
            created_at: todo.created_at
            updated_at: todo.updated_at
        }
    }

    query page_todos(input: ListTodos, principal: Principal.user)
    freshness: authoritative
        -> TodoPage
    {
        return attempt query page Todo -> TodoPage {
            where: owner_id == Todo.owner_id(principal.user_id)
            and: deleted_at == none
            and: status matches optional input.status
            and: due_at <= optional input.due_before
            order_by: created_at desc, id desc
            after: optional input.after
            limit: input.page_size
            project: TodoView
            cursor: TodoCursor(created_at, id)
        }
    }

    action get(todo_id: Todo.id)
        fails TodoNotFound
        -> TodoView
    {
        return attempt Todo.by_id(todo_id)
    }

    action list_todos(input: ListTodos, principal: Principal.user)
        -> TodoPage
    {
        return Todo.page_todos(input, principal)
    }

    action create_todo(input: CreateTodo, principal: Principal.user)
        fails DueDateInPast, TodoMutationConflict
        -> TodoView
    {
        match input.due_at {
            some(due_at) => {
                if (due_at <= clock.now) {
                    reject DueDateInPast
                }
            }
            none => {}
        }

        var todo = attempt create Todo {
            owner_id: Todo.owner_id(principal.user_id)
            title: input.title
            status: Todo.status(TodoStatus.open)
            due_at: input.due_at
            reminder_sent_at: none
        } conflict: TodoMutationConflict

        return TodoView {
            id: todo.id
            title: todo.title
            status: todo.status
            due_at: todo.due_at
            created_at: todo.created_at
            updated_at: todo.updated_at
        }
    }

    action patch_todo(todo_id: Todo.id, input: PatchTodo, principal: Principal.user)
        fails TodoNotFound, EmptyPatch, DueDateInPast, TodoMutationConflict
        -> TodoView
    {
        var existing = attempt Todo.by_id(todo_id)

        match input.due_at {
            some(due_at) => {
                if (due_at <= clock.now) {
                    reject DueDateInPast
                }
            }
            none => {}
        }

        var todo = attempt update required Todo {
            where: id == todo_id
            patch: input
            empty: EmptyPatch
            set: {
                reminder_sent_at: none when input.due_at supplied
            }
            missing: TodoNotFound {
                todo_id: todo_id
            }
            conflict: TodoMutationConflict
        }

        return TodoView {
            id: todo.id
            title: todo.title
            status: todo.status
            due_at: todo.due_at
            created_at: todo.created_at
            updated_at: todo.updated_at
        }
    }

    action delete_todo(todo_id: Todo.id, principal: Principal.user)
        fails TodoNotFound, TodoMutationConflict
        -> Unit
    {
        var todo = attempt update required Todo {
            where: id == todo_id
            transition: delete
            missing: TodoNotFound {
                todo_id: todo_id
            }
            conflict: TodoMutationConflict
        }
    }

}
