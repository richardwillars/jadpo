failure UserNotFound {
    kind: NotFound
    code: "user_not_found"
    message: "User not found."

    internal {
        user_id: User.id
    }
}

failure UserMutationConflict {
    kind: Conflict
    code: "user_mutation_conflict"
    message: "The user could not be changed."
}

entity User {
    id: Uuid {
        role: UserRole.self
        immutable: true
    }
    authentication_subject: Text {
        policy {}
    }
    email: Email {
        policy {}
    }
    status: UserStatus {
        policy {
            UserRole.self: [update]
        }
    }
    created_at: Instant { policy {} } generated { on: create }
    disabled_at: Instant? {
        policy {
            UserRole.self: [update]
        }
    }

    identity: id

    persistence {
        store: primary
        role: authority
        unique: authentication_subject
        unique: email
        inverse todos: many Todo via: Todo.owner_id
    }

    policy {
        UserRole.self: [read]

        operations {
            disable_user {
                UserRole.self: [update]
            }
        }
    }

    lifecycle {
        initial: {
            status: User.status(UserStatus.active)
            disabled_at: none
        }
        visible when status == UserStatus.active
        transition disable {
            from: status == UserStatus.active
            set: {
                status: User.status(UserStatus.disabled)
                disabled_at: clock.now
            }
        }
    }

    query with_todos(user_id: User.id, principal: Principal.user, page_start: UserTodoPageStart)
    freshness: authoritative
        fails UserNotFound
        -> UserWithTodos
    {
        var user = attempt query required User {
            where: id == user_id
            missing: UserNotFound {
                user_id: user_id
            }
        }

        var page = attempt query page Todo -> TodoPage {
            where: owner_id == Todo.owner_id(user.id)
            and: deleted_at == none
            order_by: created_at asc, id asc
            after: optional page_start.after
            limit: 100
            project: TodoView
            cursor: TodoCursor(created_at, id)
        }

        return UserWithTodos {
            user_id: user.id
            todos: page.items
        }
    }

    action read_with_todos(user_id: User.id, principal: Principal.user)
        fails UserNotFound
        -> UserWithTodos
    {
        return attempt User.with_todos(user_id, principal, UserTodoPageStart {})
    }

    action disable_user(user_id: User.id, principal: Principal.user)
        fails UserNotFound, UserMutationConflict
        -> Unit
    {
        var user = attempt update required User {
            where: id == user_id
            transition: disable
            missing: UserNotFound {
                user_id: user_id
            }
            conflict: UserMutationConflict
        }
    }

}
