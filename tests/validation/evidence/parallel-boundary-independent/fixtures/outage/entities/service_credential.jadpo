entity ServiceCredential {
    id: Uuid
    service_id: Service.id
    verifier: CredentialVerifier
    status: CredentialStatus
    expires_at: Instant
    created_at: Instant generated { on: create }
    revoked_at: Instant?

    identity: id

    persistence {
        store: primary
        role: authority
        unique: verifier
        references service_id: Service.id as: service on_delete: cascade
    }
}
