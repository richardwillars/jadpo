entity User {
    id: Uuid identity
    inverse notes: many Note via Note.owner_id
}

entity Note {
    id: Uuid identity
    owner_id: User.id references User.id on_delete restrict

    projection search_index {
        store: search
        from: Note
        delivery: durable
    }

    cache recent_notes {
        store: redis
        from: Note
        strategy: invalidate
        delivery: durable
    }
}

type LegacyUser = Object {
    id: Uuid
}

type LegacyState = Enum {
    pending
    sent
}

type LegacyNote = Object {
    id: Uuid
    user_id: LegacyUser.id
}

persist LegacyUser {
    identity: id
    inverse notes: many LegacyNote via: LegacyNote.user_id
}

persist LegacyNote {
    identity: id
    references user_id: LegacyUser.id on_delete: restrict
}

query read_after_write(user_id: User.id) freshness: read_your_writes -> User? { return attempt query optional User { where: id == user_id } }
query bounded(user_id: User.id) freshness: bounded_staleness -> User? { return attempt query optional User { where: id == user_id } }
query eventually(user_id: User.id) freshness: eventual -> User? { return attempt query optional User { where: id == user_id } }

type ScaledValue = Decimal {
    min: -1.5
    max: 9.25
    pattern: "^A\\nB$"
    format: decimal
}

input SearchFilter {
    phrase: Text? default none
}

config Defaults {
    title: Text {
        binding: "TITLE"
        default: "Example"
    }
    retry_count: Int {
        binding: "RETRY_COUNT"
        default: 3
    }
    ratio: Decimal {
        binding: "RATIO"
        default: 0.75
    }
    enabled: Bool {
        binding: "ENABLED"
        default: false
    }
    delay: Duration {
        binding: "DELAY"
        default: 5m
    }
}

authentication browser_session {
    transport {
        cookie: "jadpo_session"
    }
    validators {
        signed_cookie {
            mode: signed
            principal: user
            secret: config.session_key
            previous_secret: config.previous_session_key
            audience: config.session_audience
            origin: config.browser_origin
        }
    }
}

authentication api_bearer {
    transport {
        bearer: authorization_header
    }
    validators {
        service_key {
            mode: api_key
            principal: service
            secret: config.session_key
            audience: "worker"
            owner: Worker.operator_id
            credentials {
                identity: AccessGrant.key
                principal: AccessGrant.worker
                verifier: AccessGrant.digest
                active: state == GrantState.usable
                expires: AccessGrant.deadline
                revoked: AccessGrant.withdrawn
            }
        }
    }
}

action choose(flag: Bool) -> Int {
    if flag == true {
        return 1
    } else {
        return 2
    }
}

query newest(user_id: User.id) freshness: eventual -> List<User> {
    return attempt query many User {
        where: id == user_id
        order_by: id desc
        limit: 10 offset: 0
    }
}
