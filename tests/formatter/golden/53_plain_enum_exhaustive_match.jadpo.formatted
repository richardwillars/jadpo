enum DeliveryState {
    pending
    sent
    failed
}

input DeliveryRequest {
    state: DeliveryState
}

output DeliveryMessage {
    description: Text
}

function mark_sent(state: DeliveryState) -> DeliveryState {
    return DeliveryState.sent
}

action describe_delivery(input: DeliveryRequest) -> DeliveryMessage {
    match input.state {
        DeliveryState.pending => {
            return DeliveryMessage { description: "Pending" }
        }
        DeliveryState.sent => {
            return DeliveryMessage { description: "Sent" }
        }
        DeliveryState.failed => {
            return DeliveryMessage { description: "Failed" }
        }
    }
}

route POST /delivery-description {
    auth: none
    input: DeliveryRequest
    output: DeliveryMessage
    run: describe_delivery(input)
}
