type Decision = Bool {}

input MatchInput {
    enabled: Bool
    name: Text
    nickname: Text?
}

output MatchResult {
    description: Text
}

function is_enabled(input: MatchInput) -> Decision {
    return Decision(input.enabled)
}

action describe_match(input: MatchInput) -> MatchResult {
    match is_enabled(input) {
        true => {}
        false => {}
    }

    match input.nickname {
        none => {}
        some(nickname) => {
            if nickname == "admin" {}
        }
    }

    match input.name {
        "admin" => {
            return MatchResult { description: "Administrator" }
        }
        _ => {
            return MatchResult { description: "User" }
        }
    }
}
