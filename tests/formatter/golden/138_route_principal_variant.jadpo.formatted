application Demo {
    authentication {
        principal: Principal
        revocation {
            mode: immediate
        }
    }
}

principal Principal {
    user {
        user_id: Uuid
    }
    service {
        service_id: Uuid
    }
}

output UserIdentity {
    id: Uuid
}

output ServiceIdentity {
    id: Uuid
}

query user_identity(principal: Principal.user) -> UserIdentity {
    policy {
        Access.authenticated: [invoke]
    }
    return UserIdentity {
        id: principal.user_id
    }
}

query service_identity(principal: Principal.service) -> ServiceIdentity {
    policy {
        Access.authenticated: [invoke]
    }
    return ServiceIdentity {
        id: principal.service_id
    }
}

route GET /user-identity {
    output: UserIdentity
    run: user_identity(current_principal.user)
}

route GET /service-identity {
    output: ServiceIdentity
    run: service_identity(current_principal.service)
}
