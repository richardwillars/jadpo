failure RecordNotFound {
    kind: NotFound
    code: "record_not_found"
}

failure RecordConflict {
    kind: Conflict
    code: "record_conflict"
}

entity Customer {
    id: Uuid
    email: Email
    identity: id

    persistence {
        store: primary
        role: authority
        unique: email
    }

    action change_email(id: Customer.id, email: Customer.email)
        fails RecordNotFound, RecordConflict
        -> Customer
    {
        return attempt update required Customer {
            where: id == id
            set: { email: email }
            missing: RecordNotFound
            conflict: RecordConflict
        }
    }
}

entity Account {
    id: Uuid
    label: Text
    identity: id

    persistence {
        store: primary
        role: authority
    }

    action relabel(id: Account.id, label: Account.label)
        fails RecordNotFound, RecordConflict
        -> Account
    {
        return attempt update required Account {
            where: id == id
            set: { label: label }
            missing: RecordNotFound
            conflict: RecordConflict
        }
    }
}

action update_customer_account(
    customer_id: Customer.id,
    email: Customer.email,
    account_id: Account.id,
    label: Account.label
)
consistency: atomic
    fails RecordNotFound, RecordConflict
    -> Account
{
    var customer = attempt Customer.change_email(customer_id, email)
    return attempt Account.relabel(account_id, label)
}
