enum UserStatus { active disabled }
enum TodoStatus { open completed }

config LifecycleConfiguration {
    soft_delete_retention: Duration {
        binding: "JADPO_LIFECYCLE_RETENTION"
    }
}

failure UserMissing {
    kind: NotFound
    code: "user_missing"
    message: "User not found."
}

failure UserConflict {
    kind: Conflict
    code: "user_conflict"
    message: "User cannot be changed."
}

output TodoOwner {
    parent: Todo
    owner: User
}

output UserWithTodos {
    parent: User
    todos: List<Todo>
}

input LifecycleOwnerFilter {
    batch_group: User.batch_group
}

input TodoUserFilter {
    user_id: Todo.user_id
}

input LifecycleTodoFilter {
    title: Todo.title
}

input RenameLifecycleTodo {
    title: Todo.title
}

input CreateLifecycleUser {
    name: User.name
    batch_group: User.batch_group
}

input CreateLifecycleTodo {
    user_id: Todo.user_id
    title: Todo.title
    status: Todo.status
}

entity User {
    id: Uuid { generated: identity }
    name: Text
    batch_group: Text
    status: UserStatus
    disabled_at: Instant?
    updated_at: Instant generated { on: create_or_change }

    identity: id
    persistence {
        store: primary
        role: authority
        index: batch_group
        inverse todos: many Todo via: Todo.user_id
    }
    lifecycle {
        initial: {
            status: User.status(UserStatus.active)
            disabled_at: none
        }
        visible when status == UserStatus.active
        transition disable {
            from: status == UserStatus.active
            set: {
                status: User.status(UserStatus.disabled)
                disabled_at: clock.now
            }
        }
    }

    action create_user(name: User.name, batch_group: User.batch_group) -> User {
        return attempt create User { name: name batch_group: batch_group }
    }

    action disable_user(id: User.id) -> User
        fails UserMissing, UserConflict
    {
        return attempt update required User {
            where: id == id
            transition: disable
            missing: UserMissing
            conflict: UserConflict
        }
    }

    query lifecycle_owners(input: LifecycleOwnerFilter)
    freshness: authoritative
        -> List<UserWithTodos>
    {
        return attempt query many User {
            where: batch_group == input.batch_group
            order_by: id asc
            limit: 500 offset: 0
            include: todos into: UserWithTodos order_by: id asc limit: 500 offset: 0
        }
    }
}

failure TodoMissing {
    kind: NotFound
    code: "todo_missing"
    message: "Todo not found."
}

failure TodoConflict {
    kind: Conflict
    code: "todo_conflict"
    message: "Todo cannot be changed."
}

entity Todo {
    id: Uuid { generated: identity }
    user_id: User.id
    title: Text
    status: TodoStatus
    deleted_at: Instant?
    updated_at: Instant generated { on: create_or_change }

    identity: id
    persistence {
        store: primary
        role: authority
        index: title
        references user_id: User.id as: owner on_delete: restrict
    }
    lifecycle {
        initial: {
            deleted_at: none
        }
        visible when deleted_at == none
        transition delete {
            from: deleted_at == none
            set: { deleted_at: clock.now }
        }
        purge after config.soft_delete_retention from deleted_at
    }

    action create_todo(user_id: User.id, title: Todo.title, status: Todo.status) -> Todo {
        return attempt create Todo {
            user_id: Todo.user_id(user_id)
            title: title
            status: status
        }
    }

    query owner_for_todo(id: Todo.id)
    freshness: authoritative
        fails TodoMissing
        -> TodoOwner
    {
        return attempt query required Todo {
            where: id == id
            include: owner required into: TodoOwner
            missing: TodoMissing
        }
    }

    query visible_page(input: TodoUserFilter)
    freshness: authoritative
        -> List<Todo>
    {
        return attempt query many Todo {
            where: user_id == input.user_id
            order_by: id asc
            limit: 100 offset: 0
        }
    }

    query reminder_page(input: LifecycleTodoFilter)
    freshness: authoritative
        -> List<TodoOwner>
    {
        return attempt query many Todo {
            where: title == input.title
            order_by: id asc
            limit: 500 offset: 0
            include: owner required into: TodoOwner
        }
    }

    action delete_todo(id: Todo.id) -> Todo
        fails TodoMissing, TodoConflict
    {
        return attempt update required Todo {
            where: id == id
            transition: delete
            missing: TodoMissing
            conflict: TodoConflict
        }
    }

    action rename_todo(id: Todo.id, title: Todo.title) -> Todo
        fails TodoMissing, TodoConflict
    {
        return attempt update required Todo {
            where: id == id
            set: { title: title }
            missing: TodoMissing
            conflict: TodoConflict
        }
    }

    action nested_rename_todo(id: Todo.id, title: Todo.title) -> Todo
        fails TodoMissing, TodoConflict
    {
        return attempt Todo.rename_todo(id, title)
    }
}

entity UserReference {
    id: Uuid { generated: identity }
    user_id: User.id

    identity: id
    persistence {
        store: primary
        role: authority
        references user_id: User.id on_delete: restrict
    }
}

entity TodoReference {
    id: Uuid { generated: identity }
    todo_id: Todo.id

    identity: id
    persistence {
        store: primary
        role: authority
        references todo_id: Todo.id on_delete: restrict
    }
}

route POST /lifecycle/users {
    auth: none
    input: CreateLifecycleUser
    output: User
    run: User.create_user(input.name, input.batch_group)
}

route POST /lifecycle/todos {
    auth: none
    input: CreateLifecycleTodo
    output: Todo
    run: Todo.create_todo(input.user_id, input.title, input.status)
}

route POST /lifecycle/reminders {
    auth: none
    input: LifecycleTodoFilter
    output: List<TodoOwner>
    run: Todo.reminder_page(input)
}

route POST /lifecycle/todos/{todo_id}/delete {
    auth: none
    path: {
        todo_id: Todo.id
    }
    output: Todo
    run: Todo.delete_todo(path.todo_id)
}

route POST /lifecycle/todos/{todo_id}/rename {
    auth: none
    path: {
        todo_id: Todo.id
    }
    input: RenameLifecycleTodo
    output: Todo
    run: Todo.nested_rename_todo(path.todo_id, input.title)
}
