type CustomerId = Uuid {}

output CustomerView {
    id: CustomerId
}

failure CustomerNotFound {
    kind: NotFound
    code: "customer_not_found"
}

route GET /customers/{customer_id} {
    auth: none
    path: {
        customer_id: CustomerId
    }
    output: CustomerView
    action: fails CustomerNotFound {
        reject CustomerNotFound
    }
}
