type ReceiptId = Uuid {}
type DeclineReason = Text {}
type OutcomeLabel = Text {}
type EventTime = Instant {}

enum PaymentOutcome {
    pending {
        started_at: EventTime
    }
    paid {
        receipt_id: ReceiptId
        paid_at: EventTime
    }
    declined {
        reason: DeclineReason
    }
}

input OutcomeRequest {
    outcome: PaymentOutcome
}

output OutcomeView {
    label: OutcomeLabel
    receipt_id: ReceiptId?
    reason: DeclineReason?
}

function make_paid(receipt_id: ReceiptId, paid_at: EventTime) -> PaymentOutcome {
    return PaymentOutcome.paid {
        receipt_id: receipt_id
        paid_at: paid_at
    }
}

action describe_outcome(input: OutcomeRequest) -> OutcomeView {
    match input.outcome {
        PaymentOutcome.pending { started_at } => {
            return OutcomeView {
                label: OutcomeLabel("pending")
                receipt_id: none
                reason: none
            }
        }
        PaymentOutcome.paid { receipt_id, paid_at } => {
            return OutcomeView {
                label: OutcomeLabel("paid")
                receipt_id: receipt_id
                reason: none
            }
        }
        PaymentOutcome.declined { reason } => {
            return OutcomeView {
                label: OutcomeLabel("declined")
                receipt_id: none
                reason: reason
            }
        }
    }
}

route POST /outcome-description {
    auth: none
    input: OutcomeRequest
    output: OutcomeView
    run: describe_outcome(input)
}
