type RequestText = Text {}
type ResponseText = Text {}

function normalize(input: RequestText) -> ResponseText {
    return ResponseText(input)
}

function normalize_twice(input: RequestText) -> ResponseText {
    return normalize(input)
}

action prepare(input: RequestText) -> ResponseText {
    return normalize_twice(input)
}

action execute(input: RequestText) -> ResponseText {
    return prepare(input)
}

route POST /execute {
    auth: none
    input: RequestText
    output: ResponseText
    run: execute(input)
}
