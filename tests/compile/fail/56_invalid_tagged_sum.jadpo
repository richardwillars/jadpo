type ReceiptId = Uuid {}

enum PaymentOutcome {
    pending
    paid {
        receipt_id: ReceiptId
    }
}

output OutcomeView {
    receipt_id: ReceiptId?
}

function invalid_construction() -> PaymentOutcome {
    return PaymentOutcome.paid {}
}

action invalid_pattern(outcome: PaymentOutcome) -> OutcomeView {
    match outcome {
        PaymentOutcome.pending => {
            return OutcomeView { receipt_id: none }
        }
        PaymentOutcome.paid { absent } => {
            return OutcomeView { receipt_id: none }
        }
    }
}
