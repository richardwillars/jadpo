application BoundaryApplication {
    authentication {
        principal: Principal
        revocation { mode: immediate }
    }
}

principal Principal {
    user {
        subject: Text
        user_id: Text
    }
    service {
        subject: Text
    }
}

entity EphemeralIdentity {
    id: Text
    enabled: Bool
    identity: id
}

output PrincipalLeak {
    actor: Principal
}

output SafeResult {
    ok: Bool
}

failure UnsafeFailure {
    kind: Rejected
    code: "unsafe_failure"
    internal {
        actor: Principal.user
    }
}

failure WrongInactive {
    kind: NotFound
    code: "wrong_inactive"
}

input ReservedInput {
    authorization: Text
    supplied_identity: Principal
}

authentication boundary {
    transport { bearer: authorization_header }
    validators {
        user_token { mode: opaque principal: user }
        service_token { mode: api_key principal: service }
    }
    claims {
        profile -> Principal.user.subject
    }
    resolution user {
        authority: EphemeralIdentity.id
        active: enabled == true
        mappings {
            id -> Principal.user.user_id
        }
        inactive: WrongInactive
    }
}

action principal_required() -> SafeResult {
    var actor = principal
    return SafeResult { ok: true }
}

route POST /public-boundary {
    auth: none
    input: ReservedInput
    output: SafeResult
    run: principal_required()
}
