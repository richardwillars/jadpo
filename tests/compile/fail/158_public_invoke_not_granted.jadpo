enum ApplicationRole {
    operator
}

entity User {
    id: Uuid identity
}

entity ApplicationMembership {
    id: Uuid identity
    user_id: User.id
    role: ApplicationRole

    membership {
        scope: application
        member: user_id
        role: role
    }
}

output Health {
    ok: Bool
}

action administrative_health() -> Health {
    policy {
        ApplicationRole.operator: [invoke]
    }
    return Health { ok: true }
}

route GET /administrative-health {
    auth: none
    output: Health
    run: administrative_health()
}
