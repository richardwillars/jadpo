application TodoApplication {
    authentication {
        principal: Principal
        revocation {
            mode: immediate
        }
    }
}

principal Principal {
    user {
        subject: Text
        user_id: Uuid
    }
    service {
        subject: Text
        service_id: Uuid
    }
}

entity User {
    id: Uuid identity
    authentication_subject: Text unique
    email: Text
}

failure UserDisabled {
    kind: Rejected
    code: "user_disabled"
    message: "User is disabled."
}

authentication repeated {
    transport { cookie: "shared_cookie" }
    validators {
        first { mode: signed principal: user }
    }
}

authentication repeated {
    transport { cookie: "ignored_cookie" }
    validators {
        second { mode: signed principal: user }
    }
}

authentication duplicate_slot {
    transport { cookie: "shared_cookie" }
    validators {
        third { mode: opaque principal: user }
    }
}

authentication bearer_in_url {
    transport { bearer: query }
    validators {
        fourth { mode: opaque principal: user }
    }
}

authentication invalid_validator {
    transport { cookie: "invalid_validator_cookie" }
    validators {
        unsupported {
            mode: homegrown_crypto
            principal: administrator
        }
    }
    claims {
        email -> User.email
        display_name -> User.email
        external_id -> Principal.user.user_id
    }
}

authentication empty_validators {
    transport { cookie: "empty_validator_cookie" }
    validators {}
}

authentication duplicate_validator {
    transport { cookie: "duplicate_validator_cookie" }
    validators {
        same { mode: signed principal: user }
        same { mode: opaque principal: service }
    }
}

authentication invalid_resolution {
    transport { cookie: "invalid_resolution_cookie" }
    validators {
        user_token { mode: opaque principal: user }
    }
    resolution user {
        authority: User
        active: true
        mappings {}
        inactive: UserDisabled
    }
    resolution user {
        authority: User.authentication_subject
        active: true
        mappings {
            id -> Principal.user.subject
        }
        inactive: UserDisabled
    }
    resolution service {
        authority: User.email
        active: true
        mappings {
            authentication_subject -> Principal.service.subject
            id -> Principal.service.service_id
        }
        inactive: UserDisabled
    }
}
