input CreatePayment {
    amount: Int
}

entity Payment {
    id: Uuid { generated: identity }
    amount: Int

    identity: id
    persistence {
        store: primary
        role: authority
    }

    action create_and_charge(input: CreatePayment) -> Payment {
        var payment = attempt create Payment { amount: input.amount }
        var provider_result = PaymentProvider.charge(payment.id)
        return payment
    }
}
