enum NoteRole {
    owner
}

entity User {
    id: Uuid identity
}

failure NoteNotFound {
    kind: NotFound
    code: "note_not_found"
}

output LabelMatch {
    matches: Bool
}

entity PrivateNote {
    id: Uuid identity
    owner_id: User.id {
        role: NoteRole.owner
        immutable: true
    }
    private_label: Text {
        policy {
            NoteRole.owner: [read]
        }
    }

    policy {
        Access.authenticated: [read]
        NoteRole.owner: [read]
    }

    query label_matches(id: PrivateNote.id)
        freshness: authoritative
        fails NoteNotFound
        -> LabelMatch
    {
        var note = attempt query required PrivateNote {
            where: id == id
            missing: NoteNotFound
        }
        return LabelMatch {
            matches: note.private_label == "internal"
        }
    }
}
