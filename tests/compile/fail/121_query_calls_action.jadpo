entity Customer {
    id: Uuid
    identity: id
    persistence {
        store: primary
        role: authority
    }

    action register(id: Customer.id) -> Customer {
        return attempt create Customer { id: id }
    }

    query illegal(id: Customer.id)
        freshness: authoritative
        -> Customer
    {
        return Customer.register(id)
    }
}
