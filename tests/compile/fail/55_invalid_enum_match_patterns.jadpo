enum DeliveryState {
    pending
    sent
}

output MatchResult {
    description: Text
}

action describe_match(state: DeliveryState) -> MatchResult {
    match state {
        DeliveryState.pending => {}
        DeliveryState.pending => {}
        DeliveryState.absent => {}
        _ => {}
        DeliveryState.sent => {}
    }
    return MatchResult { description: "Done" }
}
