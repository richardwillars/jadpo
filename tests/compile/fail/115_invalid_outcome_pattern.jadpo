type LookupKey = Text {}
type LookupResult = Text {}

failure LookupMissing {
    kind: NotFound
    code: "lookup_missing"
}

function lookup(key: LookupKey)
    fails LookupMissing
    -> LookupResult
{
    reject LookupMissing
}

function invalid_pattern(key: LookupKey) -> LookupResult {
    return match lookup(key) {
        success(value) => value
        otherwise => LookupResult("fallback")
        failure LookupMissing => LookupResult("missing")
    }
}
