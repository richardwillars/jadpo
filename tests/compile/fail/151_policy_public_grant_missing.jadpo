entity Article {
    id: Uuid
    title: Text
    identity: id

    persistence {
        store: primary
        role: authority
    }

    policy {
        Access.authenticated: [read]
    }

    query by_id(id: Article.id)
        freshness: authoritative
        -> Article?
    {
        return attempt query optional Article {
            where: id == id
        }
    }
}

route GET /articles/{article_id} {
    auth: none
    path: {
        article_id: Article.id
    }
    output: Article?
    run: Article.by_id(path.article_id)
}
