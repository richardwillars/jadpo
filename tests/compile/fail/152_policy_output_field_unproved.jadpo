enum CompanyRole {
    owner
    viewer
}

entity User {
    id: Uuid identity
}

failure ArticleNotFound {
    kind: NotFound
    code: "article_not_found"
}

entity Company {
    id: Uuid identity
    owner_id: User.id {
        role: CompanyRole.owner
        immutable: true
    }
}

entity CompanyMembership {
    id: Uuid identity
    company_id: Company.id
    user_id: User.id
    role: CompanyRole

    membership {
        scope: company_id
        member: user_id
        role: role
    }

    policy {
        CompanyRole.owner: [create, read, update, delete]
    }
}

entity Article {
    id: Uuid identity
    company_id: Company.id { immutable: true }
    title: Text
    billing_reference: Text {
        policy {
            CompanyRole.owner: [read]
        }
    }

    policy {
        CompanyRole.owner: [read]
        CompanyRole.viewer: [read]
    }

    query by_id(id: Article.id)
        freshness: authoritative
        fails ArticleNotFound
        -> Article
    {
        return attempt query required Article {
            where: id == id
            missing: ArticleNotFound
        }
    }
}
