application TodoApplication {
    authentication {
        principal: Principal
        revocation { mode: immediate }
    }
}

principal Principal {
    user {
        subject: Text
        user_id: Uuid
    }
    service {
        subject: Text
        service_id: Uuid
    }
}

entity User {
    id: Uuid identity
    login: Text unique
    email: Text
    enabled: Text
}

failure UserDisabled {
    kind: Rejected
    code: "user_disabled"
    message: "User is disabled."
}

authentication invalid_resolution_types {
    transport { cookie: "invalid_resolution_types" }
    validators {
        user_token { mode: opaque principal: user }
    }
    claims {
        external_id -> Principal.user.user_id
    }
    resolution user {
        authority: User.email
        active: enabled
        mappings {
            email -> Principal.user.user_id
        }
        inactive: UserDisabled
    }
}
