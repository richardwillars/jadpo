application Demo {
    authentication {
        principal: Principal
        revocation {
            mode: immediate
        }
    }
}

principal Principal {
    user {
        user_id: Uuid
    }
    service {
        service_id: Uuid
    }
}

output UserIdentity {
    id: Uuid
}

query user_identity(principal: Principal.user) -> UserIdentity {
    policy {
        Access.public: [invoke]
    }
    return UserIdentity {
        id: principal.user_id
    }
}

route GET /public-user-identity {
    auth: none
    output: UserIdentity
    run: user_identity(current_principal.user)
}
