enum NoteRole {
    owner
}

entity User {
    id: Uuid identity
}

entity PrivateNote {
    id: Uuid identity
    owner_id: User.id {
        role: NoteRole.owner
        immutable: true
    }
    private_label: Text {
        policy {
            NoteRole.owner: [read, update]
        }
    }

    policy {
        NoteRole.owner: [read]
    }
}
