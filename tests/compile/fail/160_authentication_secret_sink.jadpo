application Example {
    authentication { principal: Principal revocation { mode: immediate } }
}
principal Principal {
    user { subject: Text user_id: Uuid }
    service { subject: Text service_id: Uuid }
}
entity User { id: Uuid identity subject: Text unique enabled: Bool }
failure Disabled { kind: Rejected code: "disabled" message: "Disabled." }
authentication browser {
    transport { cookie: "session" }
    validators {
        opaque_user {
            mode: opaque
            principal: user
            secret: "must-not-be-source-code"
        }
    }
    resolution user {
        authority: User.subject
        active: enabled == true
        mappings { subject -> Principal.user.subject id -> Principal.user.user_id }
        inactive: Disabled
    }
}
