entity Customer {
    email: Email
}

entity Supplier {
    email: Email
}

value Result {
    ok: Bool
}

failure CustomerRejected {
    kind: Rejected
    code: "customer_rejected"

    internal {
        email: Customer.email
    }
}

action reject_supplier(supplier: Supplier) -> Result
    fails CustomerRejected
{
    reject CustomerRejected {
            email: supplier.email
    }
}
