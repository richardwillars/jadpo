application FirstApplication {
    authentication {
        principal: FirstPrincipal
        revocation {
            mode: bounded
        }
    }
}

application SecondApplication {
    authentication {
        principal: FirstPrincipal
        revocation {
            mode: immediate
            maximum_delay: 5m
        }
    }
}

principal FirstPrincipal {
    user {
        subject: Text
    }
}

principal SecondPrincipal {
    user {
        subject: Text
    }
    user {
        subject: Text
    }
    service {
        subject: Text
    }
}
