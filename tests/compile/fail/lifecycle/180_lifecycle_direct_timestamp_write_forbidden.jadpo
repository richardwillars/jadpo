failure TodoMissing {
    kind: NotFound
    code: "todo_missing"
}

failure TodoConflict {
    kind: Conflict
    code: "todo_conflict"
}

entity Todo {
    id: Uuid { generated: identity }
    deleted_at: Instant?

    identity: id
    persistence {
        store: primary
        role: authority
    }
    lifecycle {
        initial: { deleted_at: none }
        visible when deleted_at == none
        transition delete {
            from: deleted_at == none
            set: { deleted_at: clock.now }
        }
    }

    action restore_deleted_at(id: Todo.id) -> Todo
        fails TodoMissing, TodoConflict
    {
        return attempt update required Todo {
            where: id == id
            set: { deleted_at: clock.now }
            missing: TodoMissing
            conflict: TodoConflict
        }
    }
}
