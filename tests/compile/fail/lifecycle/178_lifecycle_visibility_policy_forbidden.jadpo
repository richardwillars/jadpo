entity Todo {
    id: Uuid { generated: identity }
    deleted_at: Instant?
    identity: id
    persistence { store: primary role: authority }
    lifecycle {
        initial: { deleted_at: none }
        visible when deleted_at == none and principal.user_id == id
        transition delete {
            from: deleted_at == none
            set: { deleted_at: clock.now }
        }
    }
}
