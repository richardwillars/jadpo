input TodoLifecyclePatch {
    deleted_at: Todo.deleted_at optional
}

failure EmptyTodoPatch {
    kind: InvalidValue
    code: "empty_todo_patch"
}

failure TodoMissing {
    kind: NotFound
    code: "todo_missing"
}

failure TodoConflict {
    kind: Conflict
    code: "todo_conflict"
}

entity Todo {
    id: Uuid { generated: identity }
    deleted_at: Instant?

    identity: id
    persistence {
        store: primary
        role: authority
    }
    lifecycle {
        initial: { deleted_at: none }
        visible when deleted_at == none
        transition delete {
            from: deleted_at == none
            set: { deleted_at: clock.now }
        }
    }

    action patch_todo(id: Todo.id, input: TodoLifecyclePatch) -> Todo
        fails EmptyTodoPatch, TodoMissing, TodoConflict
    {
        return attempt update required Todo {
            where: id == id
            patch: input
            empty: EmptyTodoPatch
            missing: TodoMissing
            conflict: TodoConflict
        }
    }
}
