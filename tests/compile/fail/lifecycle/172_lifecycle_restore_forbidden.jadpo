enum UserStatus { active disabled }

entity User {
    id: Uuid { generated: identity }
    status: UserStatus

    identity: id
    persistence {
        store: primary
        role: authority
    }
    lifecycle {
        initial: { status: User.status(UserStatus.active) }
        visible when status == UserStatus.active
        transition restore {
            from: status == UserStatus.disabled
            set: { status: User.status(UserStatus.active) }
        }
    }
}
