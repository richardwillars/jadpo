enum UserStatus { active disabled }
type UserName = Text {}

failure UserMissing {
    kind: NotFound
    code: "user_missing"
    message: "User not found."
}

failure UserConflict {
    kind: Conflict
    code: "user_conflict"
    message: "User cannot be changed."
}

entity User {
    id: Uuid identity
    name: UserName
    status: UserStatus

    identity: id
    persistence {
        store: primary
        role: authority
    }
    lifecycle {
        initial: { status: User.status(UserStatus.active) }
        visible when status == UserStatus.active
        transition disable {
            from: status == UserStatus.active
            set: { status: User.status(UserStatus.disabled) }
        }
    }
    action disable_by_name(name: User.name) -> User
        fails UserMissing, UserConflict
    {
        return attempt update required User {
            where: name == name
            transition: disable
            missing: UserMissing
            conflict: UserConflict
        }
    }
}
