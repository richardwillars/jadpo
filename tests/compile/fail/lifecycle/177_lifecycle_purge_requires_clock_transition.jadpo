config LifecycleConfiguration {
    retention: Duration { binding: "LIFECYCLE_RETENTION" }
}

entity Todo {
    id: Uuid { generated: identity }
    deleted_at: Instant?
    identity: id
    persistence { store: primary role: authority }
    lifecycle {
        initial: { deleted_at: none }
        visible when deleted_at == none
        transition delete {
            from: deleted_at == none
            set: { deleted_at: none }
        }
        purge after config.retention from deleted_at
    }
}
