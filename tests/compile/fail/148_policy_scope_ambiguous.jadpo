enum CompanyRole {
    owner
}

entity User {
    id: Uuid identity
}

entity Company {
    id: Uuid identity
    owner_id: User.id {
        role: CompanyRole.owner
        immutable: true
    }

    policy {
        CompanyRole.owner: [read]
    }
}

entity InvoiceTransfer {
    id: Uuid identity
    source_company_id: Company.id
    destination_company_id: Company.id

    policy {
        CompanyRole.owner: [read]
    }
}
