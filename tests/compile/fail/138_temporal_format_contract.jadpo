locales {
    default: "en-GB"
    supported: ["en-GB"]
    unsupported: reject
}

test "invalid temporal formats" {
    var instant = Instant("2026-10-25T08:30:00Z")
    var time = temporal.in_zone(instant, Zone.europe_london)
    var raw = temporal.format(
        instant,
        locale: Locale.en_gb,
        style: TimeFormat.date_long
    )
    var both = temporal.format(
        time,
        locale: Locale.en_gb,
        style: TimeFormat.date_long,
        components: { day: numeric }
    )
    var empty = temporal.format(
        time,
        locale: Locale.en_gb,
        components: {}
    )
    var invalid = temporal.format(
        time,
        locale: Locale.en_gb,
        components: { day: enormous }
    )
    var duplicate = temporal.format(
        time,
        locale: Locale.en_gb,
        components: { day: numeric day: two_digit }
    )
}
