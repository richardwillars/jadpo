enum DeliveryState {
    pending
    sent
    failed
}

output DeliveryMessage {
    description: Text
}

action describe_delivery(state: DeliveryState) -> DeliveryMessage {
    match state {
        DeliveryState.pending => {
            return DeliveryMessage { description: "Pending" }
        }
        DeliveryState.sent => {
            return DeliveryMessage { description: "Sent" }
        }
    }
}
