entity Customer {
    id: Uuid identity
    email: Text
}

input PatchCustomer {
    email: Customer.email optional
}

failure WrongEmpty: Conflict { code "wrong_empty" }
failure CustomerNotFound: NotFound { code "customer_not_found" }
failure CustomerConflict: Conflict { code "customer_conflict" }

action patch_customer(id: Customer.id, input: PatchCustomer) -> Customer
    fails WrongEmpty, CustomerNotFound, CustomerConflict
{
    return update required Customer {
        where: id == id
        patch: input
        empty: WrongEmpty
        missing: CustomerNotFound
        conflict: CustomerConflict
    }
}
