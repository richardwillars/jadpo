type Label = Text {}

entity StoredView {
    id: Uuid identity
    rendered: PresentationText
    bad_created: CalendarDate generated { on: create }
    optional_updated: Instant? generated { on: create_or_change }
}

input CreateStoredView {
    id: StoredView.id
    bad_created: StoredView.bad_created
}

function pure_clock() -> Label {
    var observed = clock.now
    return Label("clock read")
}

action invalid_temporal(input: CreateStoredView) -> StoredView {
    var sub_millisecond = Duration("PT0.0001S")
    var unresolved = temporal.resolve(
        date: CalendarDate("2026-10-25"),
        at: "9:30",
        zone: Zone.europe_london,
        overlap: LocalOverlap.reject,
        gap: LocalGap.reject
    )
    var missing_locales = temporal.format(
        unresolved,
        style: TimeFormat.date_long
    )
    return attempt create StoredView {
        id: input.id
        rendered: missing_locales
        bad_created: input.bad_created
    } conflict: StoreConflict
}

failure StoreConflict {
    kind: Conflict
    code: "store_conflict"
}
