type Score = Int {}
type Phrase = Text {}
type Flag = Bool {}

output ResultValue {
    ok: Flag
}

function invalid(score: Score, phrase: Phrase) -> ResultValue {
    var bad_math = score + phrase
    var bad_logic = score and score
    var bad_order = score < phrase
    var bad_not = not phrase
    return ResultValue { ok: Flag(false) }
}
