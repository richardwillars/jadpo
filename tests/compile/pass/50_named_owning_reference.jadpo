entity User {
    id: Uuid identity
}

entity Todo {
    id: Uuid identity
    owner_id: User.id references User.id as owner on_delete cascade
}

input FindTodo {
    id: Todo.id
}

output TodoOwner {
    parent: Todo
    owner: User
}

failure TodoNotFound: NotFound { code "todo_not_found" }

action get_todo_owner(input: FindTodo) -> TodoOwner
    fails TodoNotFound
{
    return query required Todo {
        where: id == input.id
        include: owner required into: TodoOwner
        missing: TodoNotFound
    }
}
