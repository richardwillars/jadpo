entity Todo {
    id: Uuid identity
    due_at: Instant?
    reminder_sent_at: Instant?
}

input PatchTodo {
    due_at: Todo.due_at optional
}

failure EmptyTodoPatch {
    kind: InvalidValue code: "empty_todo_patch" }
failure TodoNotFound {
    kind: NotFound code: "todo_not_found" }
failure TodoConflict {
    kind: Conflict code: "todo_conflict" }

action patch_todo(id: Todo.id, input: PatchTodo) -> Todo
    fails EmptyTodoPatch, TodoNotFound, TodoConflict
{
    return attempt update required Todo {
        where: id == id
        patch: input
        empty: EmptyTodoPatch
        set: {
            reminder_sent_at: none when input.due_at supplied
        }
        missing: TodoNotFound
        conflict: TodoConflict
    }
}
