type PublicReference = Text {
    max_length: 32
}

type InternalReference = Text {
    max_length: 64
}

value RefusalResult {
    ok: Bool
}

failure PaymentRefused {
    kind Rejected
    code "payment_refused"
    message "Payment was refused."

    public {
        reference: PublicReference
    }

    internal {
        provider_reference: InternalReference
    }
}

action refuse_payment(
    reference: PublicReference,
    provider_reference: InternalReference
) -> RefusalResult
    fails PaymentRefused
{
    reject PaymentRefused {
        reference: reference
        provider_reference: provider_reference
    }
    return RefusalResult { ok: true }
}
