entity Customer {
    id: Uuid identity
}

failure CustomerNotFound {
    kind NotFound
    code "customer_not_found"
    message "Customer not found."

    internal {
        lookup_id: Customer.id
    }
}

action find_customer(id: Customer.id) -> Customer
    fails CustomerNotFound
{
    return attempt query required Customer {
        where: id == id
        missing: CustomerNotFound {
            lookup_id: id
        }
    }
}

route GET /customers/{customer_id} {
    auth: none
    path {
        customer_id: Customer.id
    }
    output: Customer
    run: find_customer(path.customer_id)
}
