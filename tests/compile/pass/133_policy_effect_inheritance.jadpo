enum NoteRole {
    owner
}

entity User {
    id: Uuid identity
}

failure NoteNotFound {
    kind: NotFound
    code: "note_not_found"
}

failure NoteConflict {
    kind: Conflict
    code: "note_conflict"
}

entity PrivateNote {
    id: Uuid
    owner_id: User.id {
        role: NoteRole.owner
        immutable: true
    }
    title: Text
    identity: id

    persistence {
        store: primary
        role: authority
    }

    policy {
        NoteRole.owner: [read, update]
    }

    query by_id(id: PrivateNote.id)
        freshness: authoritative
        -> PrivateNote?
    {
        return attempt query optional PrivateNote {
            where: id == id
        }
    }

    action rename(id: PrivateNote.id, title: PrivateNote.title)
        fails NoteNotFound, NoteConflict
        -> PrivateNote
    {
        return attempt update required PrivateNote {
            where: id == id
            set: { title: title }
            missing: NoteNotFound
            conflict: NoteConflict
        }
    }
}
