value Result {
    ok: Bool
}

type Allowed = Bool {}

failure Refused {
    kind: Rejected
    code: "refused"
}

function validate(allowed: Allowed) -> Result fails Refused {
    if (not allowed) {
        reject Refused
    }
    return Result { ok: true }
}

action execute(allowed: Allowed) -> Result fails Refused {
    return attempt validate(allowed)
}
