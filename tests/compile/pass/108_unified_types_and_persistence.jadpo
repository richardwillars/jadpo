type Customer = Object {
    id: Uuid
    email: Email
    contact: Object {
        preferred_email: Email
    }
    addresses: List<Object {
        line_one: Text
        city: Text
    }>
    website: Url
    last_known_ip: IpAddress
}

persist Customer {
    identity: id
    unique: email
}

failure CustomerNotFound {
    kind: NotFound code: "customer_not_found"
}

action find_customer(id: Customer.id)
    fails CustomerNotFound
    -> Customer
{
    return attempt query required Customer {
        where: id == id
        missing: CustomerNotFound
    }
}
