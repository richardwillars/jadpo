type CustomerId = Uuid {}
type OrderId = Uuid {}

output OrderView {
    customer_id: CustomerId
    order_id: OrderId
}

route GET /customers/{customer_id}/orders/{order_id} {
    auth: none
    path {
        customer_id: CustomerId
        order_id: OrderId
    }
    output: OrderView

    action {
        return OrderView {
            customer_id: path.customer_id
            order_id: path.order_id
        }
    }
}
