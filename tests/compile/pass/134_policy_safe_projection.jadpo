enum NoteRole {
    owner
}

entity User {
    id: Uuid identity
}

failure NoteNotFound {
    kind: NotFound
    code: "note_not_found"
}

output NoteSummary {
    id: PrivateNote.id
    title: PrivateNote.title
}

output PrivateNoteLabel {
    label: PrivateNote.private_label
}

entity PrivateNote {
    id: Uuid identity
    owner_id: User.id {
        role: NoteRole.owner
        immutable: true
    }
    title: Text
    private_label: Text {
        policy {
            NoteRole.owner: [read]
        }
    }

    policy {
        Access.authenticated: [read]
        NoteRole.owner: [read]

        operations {
            read_private_label {
                NoteRole.owner: [read]
            }
        }
    }

    query summary(id: PrivateNote.id)
        freshness: authoritative
        fails NoteNotFound
        -> NoteSummary
    {
        var note = attempt query required PrivateNote {
            where: id == id
            missing: NoteNotFound
        }
        return NoteSummary {
            id: note.id
            title: note.title
        }
    }


    query read_private_label(id: PrivateNote.id)
        freshness: authoritative
        fails NoteNotFound
        -> PrivateNoteLabel
    {
        var note = attempt query required PrivateNote {
            where: id == id
            missing: NoteNotFound
        }
        return PrivateNoteLabel {
            label: note.private_label
        }
    }
}
