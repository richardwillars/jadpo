type Customer = Object {
    id: Uuid
}

persist Customer {
    identity: id
}

failure CustomerNotFound {
    kind: NotFound
    code: "customer_not_found"

    internal {
        customer_id: Customer.id
    }
}

function summarize(customer: Customer) -> Customer {
    return customer
}

action load_customer(id: Customer.id)
    fails CustomerNotFound
    -> Customer
{
    return attempt query required Customer {
        where: id == id
        missing: CustomerNotFound {
            customer_id: id
        }
    }
}

action load_summary(id: Customer.id)
    fails CustomerNotFound
    -> Customer
{
    var customer = attempt load_customer(id)
    return summarize(customer)
}
