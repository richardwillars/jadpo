output CreatedItem {
    id: Text
}

action create_item() -> CreatedItem {
    return CreatedItem {
        id: "item-1"
    }
}

action remove_item() -> Unit {
}

route POST /items {
    auth: none
    output: CreatedItem
    run: create_item()
    success: created
}

route DELETE /items {
    auth: none
    run: remove_item()
    success: no_content
}
