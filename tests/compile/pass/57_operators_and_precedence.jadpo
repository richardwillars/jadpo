type Score = Int {}
type Ratio = Decimal {}
type Phrase = Text {}
type Flag = Bool {}

output Calculation {
    total: Score
    ratio: Ratio
    label: Phrase
    allowed: Flag
}

function calculate(
    left: Score,
    right: Score,
    multiplier: Score,
    prefix: Phrase,
    suffix: Phrase,
    disabled: Flag
) -> Calculation {
    var total = left + right * multiplier - (left % right)
    var ratio = left / right
    var label = prefix + suffix
    var allowed = not disabled and (left < right or left == right)
    var negative = -left

    return Calculation {
        total: Score(total + negative)
        ratio: Ratio(ratio)
        label: Phrase(label)
        allowed: Flag(allowed)
    }
}
