type PageSize = Int { min: 1 max: 100 }
type Cursor = Object {
    id: Uuid
}
type ListQuery = Object {
    page_size: PageSize default 25
    after: Cursor optional
}
type Result = Object {
    ok: Bool
}
route GET /items {
    auth: none
    query: ListQuery
    headers: {
        trace_id: Text from "X-Trace" optional
    }
    output: Result
    action: {
        return Result { ok: true }
    }
}
