entity Customer {
    id: Uuid
}

input LookupCustomer {
    id: Customer.id
}

output CustomerResult {
    id: Customer.id
}

failure CustomerNotFound {
    kind NotFound
    code "customer_not_found"
    message "Customer not found."

    internal {
        customer_id: Customer.id
    }
}

action lookup_customer(input: LookupCustomer) -> CustomerResult
    fails CustomerNotFound
{
    reject CustomerNotFound {
            customer_id: input.id
    }
}

route POST /customers/lookup {
    auth: none
    input: LookupCustomer
    output: CustomerResult
    run: lookup_customer(input)
}
