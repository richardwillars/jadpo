entity User {
    id: Uuid identity
    inverse profile: optional Profile via Profile.user_id
}

entity Profile {
    id: Uuid identity
    user_id: User.id unique references User.id on_delete cascade
}

input FindUser {
    id: User.id
}

output UserProfile {
    parent: User
    profile: Profile?
}

failure UserNotFound {
    kind NotFound code "user_not_found" }

action get_user_profile(input: FindUser) -> UserProfile
    fails UserNotFound
{
    return attempt query required User {
        where: id == input.id
        include: profile optional into: UserProfile
        missing: UserNotFound
    }
}
