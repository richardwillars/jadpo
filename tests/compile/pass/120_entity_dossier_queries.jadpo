failure CustomerNotFound {
    kind: NotFound
    code: "customer_not_found"
}

failure EmailAlreadyUsed {
    kind: Conflict
    code: "email_already_used"
}

entity Customer {
    id: Uuid
    email: Email

    identity: id

    persistence {
        store: primary
        role: authority
        unique: email
    }

    cache hot {
        store: redis
        from: primary
        strategy: invalidate
        delivery: durable
    }

    query by_email(email: Customer.email)
        freshness: authoritative
        -> Customer?
    {
        return attempt query optional Customer {
            where: email == email
        }
    }

    function contact(self: value) -> Email {
        return self.email
    }

    action change_email(self: value, email: Customer.email)
        guard: revision
        fails CustomerNotFound, EmailAlreadyUsed
        -> Customer
    {
        return attempt update required Customer {
            where: id == self.id
            set: {
                email: email
            }
            missing: CustomerNotFound
            conflict: EmailAlreadyUsed
        }
    }
}

action rename_customer(customer: Customer, email: Customer.email)
    fails CustomerNotFound, EmailAlreadyUsed
    -> Customer
{
    return attempt customer.change_email(email)
}
