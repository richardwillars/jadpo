input CreateTodo {
    title: Todo.title
}

entity Todo {
    id: Uuid { generated: identity }
    title: Text

    identity: id

    persistence {
        store: primary
        role: authority
    }

    action create_todo(input: CreateTodo) -> Todo {
        return attempt create Todo {
            title: input.title
        }
    }
}

route POST /todos {
    auth: none
    input: CreateTodo
    output: Todo
    run: Todo.create_todo(input)
}
