failure RecordNotFound {
    kind: NotFound
    code: "record_not_found"
}

entity Customer {
    id: Uuid
    identity: id
    persistence {
        store: primary
        role: authority
    }
}

entity Account {
    id: Uuid
    identity: id
    persistence {
        store: primary
        role: authority
    }
}

value CustomerAccount {
    customer: Customer
    account: Account
}

query customer_account(customer_id: Customer.id, account_id: Account.id)
    freshness: authoritative
    fails RecordNotFound
    -> CustomerAccount
{
    var customer = attempt query required Customer {
        where: id == customer_id
        missing: RecordNotFound
    }
    var account = attempt query required Account {
        where: id == account_id
        missing: RecordNotFound
    }
    return CustomerAccount {
        customer: customer
        account: account
    }
}
