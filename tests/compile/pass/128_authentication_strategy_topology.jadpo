application TodoApplication {
    authentication {
        principal: Principal
        revocation {
            mode: bounded
            maximum_delay: 5m
        }
    }
}

principal Principal {
    user {
        subject: Text
        user_id: Uuid
    }
    service {
        subject: Text
        service_id: Uuid
    }
}

entity User {
    id: Uuid identity
    authentication_subject: Text unique
    enabled: Bool
}

entity Service {
    id: Uuid identity
    credential_subject: Text unique
    enabled: Bool
}

failure PrincipalInactive {
    kind: Rejected
    code: "principal_inactive"
    message: "Principal is inactive."
}

authentication browser_session {
    transport {
        cookie: "todo_session"
    }
    validators {
        signed_session {
            mode: signed
            principal: user
        }
    }
    claims {
        subject -> Principal.user.subject
    }
    resolution user {
        authority: User.authentication_subject
        active: enabled == true
        mappings {
            authentication_subject -> Principal.user.subject
            id -> Principal.user.user_id
        }
        inactive: PrincipalInactive
    }
}

authentication api_bearer {
    transport {
        bearer: authorization_header
    }
    validators {
        opaque_user {
            mode: opaque
            principal: user
        }
        jwt_user {
            mode: jwt
            principal: user
        }
        service_key {
            mode: api_key
            principal: service
        }
    }
    resolution user {
        authority: User.authentication_subject
        active: enabled == true
        mappings {
            authentication_subject -> Principal.user.subject
            id -> Principal.user.user_id
        }
        inactive: PrincipalInactive
    }
    resolution service {
        authority: Service.credential_subject
        active: enabled == true
        mappings {
            credential_subject -> Principal.service.subject
            id -> Principal.service.service_id
        }
        inactive: PrincipalInactive
    }
}

output PrincipalIdentity {
    kind: Text
    id: Uuid
}

query current_identity() -> PrincipalIdentity {
    match principal {
        Principal.user { subject, user_id } => {
            return PrincipalIdentity {
                kind: "user"
                id: user_id
            }
        }
        Principal.service { subject, service_id } => {
            return PrincipalIdentity {
                kind: "service"
                id: service_id
            }
        }
    }
}
