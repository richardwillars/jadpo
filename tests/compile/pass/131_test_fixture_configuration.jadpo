type RequestTimeout = Duration {}

type ApiKey = Text {
    min_length: 8
}

config ApplicationConfiguration {
    request_timeout: RequestTimeout {
        binding: "REQUEST_TIMEOUT"
    }

    api_key: ApiKey {
        binding: "API_KEY"
        secret: true
    }
}

fixture configured_application {
    config {
        request_timeout: RequestTimeout("PT3S")
        api_key: secret("test-only-api-key")
    }
}

action configured_timeout() -> RequestTimeout {
    return config.request_timeout
}

test "fixture supplies typed configuration" using configured_application {
    var timeout = call configured_timeout()
    assert timeout == RequestTimeout("PT3S")
}
