locales {
    default: "en-GB"
    supported: ["en-GB", "en-US"]
    unsupported: fallback_to_default
}

entity Event {
    id: Uuid identity
    title: Text
    starts_at: Instant
    local_view: Time
    created_at: Instant generated { on: create }
    updated_at: Instant generated { on: create_or_change }
}

input CreateEvent {
    id: Event.id
    title: Event.title
    starts_at: Event.starts_at
    local_view: Event.local_view
}

input RenameEvent {
    id: Event.id
    title: Event.title
}

failure EventNotFound {
    kind: NotFound
    code: "event_not_found"
}

failure EventConflict {
    kind: Conflict
    code: "event_conflict"
}

action create_event(input: CreateEvent) -> Event
    fails EventConflict
{
    return attempt create Event {
        id: input.id
        title: input.title
        starts_at: input.starts_at
        local_view: input.local_view
    } conflict: EventConflict
}

action rename_event(input: RenameEvent) -> Event
    fails EventNotFound, EventConflict
{
    return attempt update required Event {
        where: id == input.id
        set: {
            title: input.title
        }
        missing: EventNotFound
        conflict: EventConflict
    }
}

test "temporal values are explicit" {
    var instant = Instant("2026-10-25T00:30:00+01:00")
    var local = temporal.in_zone(instant, Zone.europe_london)
    var next = temporal.add_elapsed(instant, Duration("PT1H"))
    var label = temporal.format(
        local,
        locale: Locale.en_gb,
        style: TimeFormat.date_time_long
    )
    assert next > instant
}
