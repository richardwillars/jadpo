entity Membership {
    id: Uuid identity
    tenant: Text
    email: Text
    constraint tenant_email: unique(tenant, email)
}

input CreateMembership {
    id: Membership.id
    tenant: Membership.tenant
    email: Membership.email
}

failure MembershipExists: Conflict { code "membership_exists" }
failure MembershipConflict: Conflict { code "membership_conflict" }

action create_membership(input: CreateMembership) -> Membership
    fails MembershipExists, MembershipConflict
{
    return create Membership {
        id: input.id
        tenant: input.tenant
        email: input.email
    }
    conflict Membership.tenant_email: MembershipExists
    conflict: MembershipConflict
}
