// AUTH-P6: external JWT, opaque bearer and signed cookie share one principal.
application JwtApplication {
    authentication { principal: Principal revocation { mode: bounded maximum_delay: 5m } }
}
config AuthenticationConfiguration {
    signing_key: Text { binding: "AUTH_SIGNING_KEY" secret: true }
    browser_origin: Url { binding: "BROWSER_ORIGIN" }
    issuer: Url { binding: "JWT_ISSUER" }
    audience: Text { binding: "JWT_AUDIENCE" }
    jwks_uri: Url { binding: "JWT_JWKS_URI" }
}
principal Principal {
    user { subject: Text user_id: Uuid }
    service { subject: Text service_id: Uuid }
}
entity JwtUser {
    id: Uuid identity
    authentication_subject: Text unique
    enabled: Bool
    private_profile: Text
}
failure UserDisabled { kind: NotPermitted code: "user_disabled" message: "User is disabled." }
authentication browser_session {
    transport { cookie: "__Host-jwt-test" }
    validators {
        signed_user { mode: signed principal: user secret: config.signing_key audience: "jwt-browser" origin: config.browser_origin }
    }
    resolution user {
        authority: JwtUser.authentication_subject active: enabled == true
        mappings { authentication_subject -> Principal.user.subject id -> Principal.user.user_id }
        inactive: UserDisabled
    }
}
authentication api_bearer {
    transport { bearer: authorization_header }
    validators {
        opaque_user { mode: opaque principal: user secret: config.signing_key audience: "jwt-first-party-api" }
        external_user { mode: jwt principal: user issuer: config.issuer audience: config.audience jwks_uri: config.jwks_uri }
    }
    resolution user {
        authority: JwtUser.authentication_subject active: enabled == true
        mappings { authentication_subject -> Principal.user.subject id -> Principal.user.user_id }
        inactive: UserDisabled
    }
}
output Identity { id: Uuid }
query current_identity() -> Identity {
    policy { Access.authenticated: [invoke] }
    match principal {
        Principal.user { subject, user_id } => { return Identity { id: user_id } }
        Principal.service { subject, service_id } => { return Identity { id: service_id } }
    }
}
route GET /identity { output: Identity run: current_identity() }
route GET /fresh { auth: fresh output: Identity run: current_identity() }
input IdentityRequest { label: Text }
action accept_identity(input: IdentityRequest) -> Identity {
    policy { Access.authenticated: [invoke] }
    return current_identity()
}
route POST /identity { input: IdentityRequest output: Identity run: accept_identity(input) }
type Health = Text {}
function alive() -> Health { return Health("healthy") }
route GET /live { auth: none output: Health run: alive() }
enum NoteRole { owner }
input NoteLookup { id: JwtNote.id }
output NoteView { id: JwtNote.id title: Text }
failure NoteMissing { kind: NotFound code: "note_missing" }
entity JwtNote {
    id: Uuid identity
    owner_id: JwtUser.id { role: NoteRole.owner immutable: true }
    title: Text
    policy { NoteRole.owner: [read] }
    query summary(input: NoteLookup) freshness: authoritative fails NoteMissing -> NoteView {
        var note = attempt query required JwtNote { where: id == input.id missing: NoteMissing }
        return NoteView { id: note.id title: note.title }
    }
}
route POST /notes { input: NoteLookup output: NoteView run: JwtNote.summary(input) }
