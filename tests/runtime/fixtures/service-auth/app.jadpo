// AUTH-001 §2 / AUTH-P5: explicit service owner; separately revocable credentials.
application ServiceApplication {
    authentication { principal: Principal revocation { mode: bounded maximum_delay: 5m } }
}
config AuthenticationConfiguration {
    signing_key: Text { binding: "AUTH_SIGNING_KEY" secret: true }
    previous_signing_key: Text { binding: "AUTH_PREVIOUS_SIGNING_KEY" secret: true }
    browser_origin: Url { binding: "BROWSER_ORIGIN" }
}
principal Principal {
    user { subject: Text user_id: Uuid }
    service { subject: Text service_id: Uuid }
}
entity Operator { id: Uuid identity authentication_subject: Text unique enabled: Bool }
entity Worker {
    id: Uuid identity
    authentication_subject: Text unique
    responsible_operator: Operator.id references Operator.id as owner on_delete restrict
    enabled: Bool
}
failure UserDisabled { kind: Rejected code: "user_disabled" }
failure ServiceDisabled { kind: Rejected code: "service_disabled" }
authentication browser_session {
    transport { cookie: "__Host-service-test" }
    validators { signed_user { mode: signed principal: user secret: config.signing_key previous_secret: config.previous_signing_key audience: "browser" origin: config.browser_origin } }
    resolution user {
        authority: Operator.authentication_subject active: enabled == true
        mappings { authentication_subject -> Principal.user.subject id -> Principal.user.user_id }
        inactive: UserDisabled
    }
}
authentication api_bearer {
    transport { bearer: authorization_header }
    validators {
        opaque_user { mode: opaque principal: user secret: config.signing_key previous_secret: config.previous_signing_key audience: "user-api" }
        service_key { mode: api_key principal: service secret: config.signing_key previous_secret: config.previous_signing_key audience: "service-key" owner: Worker.responsible_operator }
        service_token { mode: signed principal: service secret: config.signing_key previous_secret: config.previous_signing_key audience: "service-token" }
    }
    resolution user {
        authority: Operator.authentication_subject active: enabled == true
        mappings { authentication_subject -> Principal.user.subject id -> Principal.user.user_id }
        inactive: UserDisabled
    }
    resolution service {
        authority: Worker.authentication_subject active: enabled == true
        mappings { authentication_subject -> Principal.service.subject id -> Principal.service.service_id }
        inactive: ServiceDisabled
    }
}
output Identity { id: Uuid }
query current_identity() -> Identity {
    policy { Access.authenticated: [invoke] }
    match principal {
        Principal.user { subject, user_id } => { return Identity { id: user_id } }
        Principal.service { subject, service_id } => { return Identity { id: service_id } }
    }
}
query service_identity(principal: Principal.service) -> Identity {
    policy { Access.authenticated: [invoke] }
    return Identity { id: principal.service_id }
}
route GET /identity { output: Identity run: current_identity() }
route GET /service-identity { output: Identity run: service_identity(current_principal.service) }
route GET /fresh { auth: fresh output: Identity run: current_identity() }
type Health = Text {}
function alive() -> Health { return Health("healthy") }
route GET /live { auth: none output: Health run: alive() }
enum AssetRole { owner }
input AssetLookup { id: Asset.id }
output AssetView { id: Asset.id title: Text }
failure AssetMissing { kind: NotFound code: "asset_missing" }
entity Asset {
    id: Uuid identity
    worker_id: Worker.id { role: AssetRole.owner immutable: true }
    title: Text
    policy { AssetRole.owner: [read] }
    query summary(input: AssetLookup) freshness: authoritative fails AssetMissing -> AssetView {
        var asset = attempt query required Asset { where: id == input.id missing: AssetMissing }
        return AssetView { id: asset.id title: asset.title }
    }
}
route POST /assets { input: AssetLookup output: AssetView run: Asset.summary(input) }
